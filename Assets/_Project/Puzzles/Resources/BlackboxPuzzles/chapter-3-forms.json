        "A": {
          "signal": "shape solid amber hexagon"
        },
        "B": {
          "signal": "shape solid green triangle"
        },
        "C": {
          "signal": "shape hollow pink circle"
        }
      },
      "blocks": {
        "g": {
          "kind": "S3",
          "state": 1
        },
        "h": {
          "kind": "S1"
        },
        "k": {
          "kind": "S2"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "B -> h",
        "h -> X",
        "A -> g.0",
        "C -> g.1",
        "g -> k",
