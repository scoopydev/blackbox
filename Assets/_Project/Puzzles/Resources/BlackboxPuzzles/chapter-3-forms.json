{
  "id": "forms",
  "numeral": "III",
  "title": "Forms",
  "mode": "wiring",
  "medium": "shape",
  "tagline": "Every shape is a message.",
  "signals": "Signals here are shapes: a circle, triangle, square or hexagon, hollow or solid, in cyan, pink, amber or green. A light shows only a shape's colour; a digit display counts its corners. You hear a click for each corner, low when solid and high when hollow.",
  "circuits": [
    {
      "id": "forms-01",
      "name": "Fill",
      "hint": "These wires are drawn already. Run it, then move g's input to the other shape.",
      "inputs": {
        "A": {
          "signal": "shape solid pink triangle"
        },
        "B": {
          "signal": "shape hollow amber square"
        }
      },
      "blocks": {
        "g": {
          "kind": "S1"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g",
        "g -> X"
      ],
      "solution": [
        "B -> g",
        "g -> X"
      ]
    },
    {
      "id": "forms-02",
      "name": "Graft",
      "hint": "One of g's inputs is empty.",
      "inputs": {
        "A": {
          "signal": "shape hollow green circle"
        },
        "B": {
          "signal": "shape solid hexagon"
        }
      },
      "blocks": {
        "g": {
          "kind": "S3"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "forms-03",
      "name": "Corners",
      "hint": "A light takes a shape's colour, whatever its form or fill.",
      "inputs": {
        "A": {
          "signal": "shape solid pink triangle, solid pink hexagon"
        },
        "B": {
          "signal": "shape hollow green square"
        }
      },
      "blocks": {
        "g": {
          "kind": "S4"
        }
      },
      "outputs": {
        "X": {
          "device": "light"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "forms-04",
      "name": "Turn",
      "hint": "A digit display counts a shape's corners. A circle has none.",
      "inputs": {
        "A": {
          "signal": "shape solid triangle"
        },
        "B": {
          "signal": "shape hollow pink circle"
        }
      },
      "blocks": {
        "g": {
          "kind": "S2"
        },
        "h": {
          "kind": "S2",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "digits"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> X",
        "B -> h",
        "h -> Y"
      ]
    },
    {
      "id": "forms-05",
      "name": "Homecoming",
      "hint": "Watch the colour: it stays with the form.",
