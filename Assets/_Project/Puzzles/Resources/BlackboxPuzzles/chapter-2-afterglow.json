{
  // Chapter II: time. Every case is a trace: inputs change tick by tick and the
  // outputs are watched over time. Kinds introduced: K6, K7, K8, K9.
  // Logic kinds from Chapter I come back and behave exactly as before.
  "id": "afterglow",
  "numeral": "II",
  "title": "Afterglow",
  "tagline": "Some boxes remember.",
  "unlock": { "after": "first-light", "solved": 6 },
  "circuits": [
    {
      // K6 on its own. Starts one tick late; the answer is two.
      "id": "afterglow-01",
      "name": "Echo",
      "hint": "Time runs left to right along the bottom. Click a moment to see the circuit then.",
      "inputs": { "A": [0, 0] },
      "boxes": { "d": { "kind": "K6", "setting": 0, "at": [1, 0] } },
      "outputs": { "X": [2, 0] },
      "wires": ["A -> d", "d -> X"],
      "trace": {
        "A": "1101 0001 0000",
        "X": "0011 0100 0100"
      }
    },
    {
      // X is on while A has been on for two ticks in a row: A and (A one tick ago).
      "id": "afterglow-02",
      "name": "Hold",
      "hint": "Probe a box to see its whole history.",
      "inputs": { "A": [0, 1] },
      "boxes": {
        "d": { "kind": "K6", "setting": 2, "at": [1, 2] },
        "g": { "kind": "K3", "setting": 0, "at": [2, 1] }
      },
      "outputs": { "X": [3, 1] },
      "wires": ["A -> d", "A -> g.0", "d -> g.1", "g -> X"],
      "trace": {
        "A": "0110 1110 1100",
        "X": "0010 0110 0100"
      }
    },
    {
      // K7 compares now with the tick before. X: the moment A rises. Y: the moment it falls.
      "id": "afterglow-03",
      "name": "Edges",
      "inputs": { "A": [0, 1] },
      "boxes": {
        "e1": { "kind": "K7", "setting": 0, "at": [1, 0] },
        "e2": { "kind": "K7", "setting": 0, "at": [1, 2] }
      },
      "outputs": { "X": [2, 0], "Y": [2, 2] },
      "wires": ["A -> e1", "A -> e2", "e1 -> X", "e2 -> Y"],
      "trace": {
        "A": "0111 0011 0010",
        "X": "0100 0010 0010",
        "Y": "0000 1000 1001"
      }
    },
    {
      // K8 flips. X blinks while A is held; Y is a push button: each press turns it on or off.
      "id": "afterglow-04",
      "name": "Switch",
      "inputs": { "A": [0, 1] },
      "boxes": {
        "t1": { "kind": "K8", "setting": 1, "at": [1, 0] },
        "g": { "kind": "K3", "setting": 0, "at": [2, 0] },
        "t2": { "kind": "K8", "setting": 0, "at": [1, 2] }
      },
      "outputs": { "X": [3, 0], "Y": [3, 2] },
      "wires": ["A -> t1", "A -> g.0", "t1 -> g.1", "g -> X", "A -> t2", "t2 -> Y"],
      "trace": {
        "A": "0111 1001 1101 0",
        "X": "0101 0001 0100 0",
        "Y": "0111 1110 0001 1"
      }
    },
    {
      // K9 holds a bit. The light comes on when A is let go and stays on until B.
      // Y follows X one tick behind.
      "id": "afterglow-05",
      "name": "Doorbell",
      "inputs": { "A": [0, 0], "B": [0, 2] },
      "boxes": {
        "e": { "kind": "K7", "setting": 0, "at": [1, 0] },
        "L": { "kind": "K9", "setting": 1, "at": [2, 1] },
        "d": { "kind": "K6", "setting": 1, "at": [3, 2] }
      },
      "outputs": { "X": [4, 0.5], "Y": [4, 2] },
      "wires": ["A -> e", "e -> L.0", "B -> L.1", "L -> X", "L -> d", "d -> Y"],
      "trace": {
        "A": "0111 0000 1110 0000",
        "B": "0000 0010 0000 0110",
        "X": "0000 1100 0001 1000",
        "Y": "0000 0110 0000 1100"
      }
    },
    {
      // X turns on two ticks after A is pressed and off when B is pressed.
      "id": "afterglow-06",
      "name": "Relay",
      "inputs": { "A": [0, 0], "B": [0, 2] },
      "boxes": {
        "e1": { "kind": "K7", "setting": 0, "at": [1, 0] },
        "d": { "kind": "K6", "setting": 0, "at": [2, 0] },
        "e2": { "kind": "K7", "setting": 2, "at": [1, 2] },
        "L": { "kind": "K9", "setting": 1, "at": [3, 1] }
      },
      "outputs": { "X": [4, 1] },
      "wires": ["A -> e1", "e1 -> d", "d -> L.0", "B -> e2", "e2 -> L.1", "L -> X"],
      "trace": {
        "A": "0110 0000 0111 1000",
        "B": "0000 0011 1000 0011",
        "X": "0001 1100 0001 1100"
      }
    },
    {
      // A loop. A delay feeding an inverter feeding the delay makes a rhythm;
      // the delay's setting sets the tempo. The loop wire runs back under the board.
      "id": "afterglow-07",
      "name": "Metronome",
      "inputs": { "A": [0, 0] },
      "boxes": {
        "d": { "kind": "K6", "setting": 0, "at": [1, 1] },
        "n": { "kind": "K1", "setting": 1, "at": [2, 1.75] },
        "g": { "kind": "K3", "setting": 0, "at": [3, 0.5] }
      },
      "outputs": { "X": [4, 0.5] },
      "wires": ["d -> n", { "from": "n", "to": "d", "via": 2.6 }, "A -> g.0", "d -> g.1", "g -> X"],
      "trace": {
        "A": "1111 1111 1100 00",
        "X": "0001 1100 0100 00"
      }
    },
    {
      // A debouncer. A flickers; X should only follow it once it has been steady for two ticks.
      "id": "afterglow-08",
      "name": "Steady Hand",
      "inputs": { "A": [0, 1] },
      "boxes": {
        "d": { "kind": "K6", "setting": 2, "at": [1, 2] },
        "g1": { "kind": "K4", "setting": 0, "at": [2, 0] },
        "g2": { "kind": "K3", "setting": 1, "at": [2, 2] },
        "n": { "kind": "K1", "setting": 1, "at": [3, 2] },
        "L": { "kind": "K9", "setting": 1, "at": [4, 1] }
      },
      "outputs": { "X": [5, 1] },
      "wires": ["A -> d", "A -> g1.0", "d -> g1.1", "A -> g2.0", "d -> g2.1", "g2 -> n", "g1 -> L.0", "n -> L.1", "L -> X"],
      "trace": {
        "A": "0100 1110 1110 0010",
        "X": "0000 0111 1111 0000"
      }
    }
  ]
}
