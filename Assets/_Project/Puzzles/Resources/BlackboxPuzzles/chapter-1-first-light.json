{
  "id": "first-light",
  "numeral": "I",
  "title": "First Light",
  "mode": "wiring",
  "medium": "binary",
  "tagline": "Every block keeps a rule. Wire it to find out.",
  "signals": "Signals here are bits, 0 or 1, drawn as a line: above the middle for 1, below it for 0. At first each one stays put; later they switch between 0 and 1 as the loop plays. A 1 sounds as a beep; a 0 is only a soft tap.",
  "circuits": [
    {
      "id": "first-light-01",
      "hint": "The wires are drawn, but one starts at the wrong input. Inputs are dotted because you don't have to use them all. Click the wire into {g} to take it off, drag from B's dot to {g}'s left dot, then press RUN.",
      "inputs": {
        "A": {
          "signal": "binary 1"
        },
        "B": {
          "signal": "binary 0"
        }
      },
      "blocks": {
        "g": {
          "kind": "NOT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g",
        "g -> X"
      ],
      "solution": [
        "B -> g",
        "g -> X"
      ]
    },
    {
      "id": "first-light-02",
      "hint": "{g} has two inputs and one is empty. A block with an empty input sends nothing, so wire something into it.",
      "inputs": {
        "A": {
          "signal": "binary 1"
        },
        "B": {
          "signal": "binary 0"
        }
      },
      "blocks": {
        "g": {
          "kind": "AND"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "first-light-03",
      "hint": "Now you wire it all. Signals can change as the loop plays: 0011 is 0 for half the loop, then 1. A block works on each moment in turn.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        },
        "C": {
          "signal": "binary 1001"
        }
      },
      "blocks": {
        "g": {
          "kind": "NOT"
        },
        "h": {
          "kind": "OR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h.0",
        "B -> h.1",
        "h -> g",
        "g -> X"
      ]
    },
    {
      "id": "first-light-04",
      "hint": "Three signals and two blocks. Work out which signals each block needs, and which block comes first.",
      "inputs": {
        "A": {
          "signal": "binary 0101"
        },
        "B": {
          "signal": "binary 1000"
        },
        "C": {
          "signal": "binary 0110"
        }
      },
      "blocks": {
        "g": {
          "kind": "OR"
        },
        "h": {
          "kind": "AND"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "C -> h.0",
        "A -> h.1",
        "h -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "first-light-05",
      "hint": "One signal can feed many wires: drag from the same dot again.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        }
      },
      "blocks": {
        "g": {
          "kind": "XOR"
        },
        "h": {
          "kind": "NOT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "A -> h",
        "g -> X",
        "h -> Y"
      ]
    },
    {
      "id": "first-light-06",
      "hint": "Three blocks, one after another.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        },
        "C": {
          "signal": "binary 1"
        }
      },
      "blocks": {
        "g": {
          "kind": "OR"
        },
        "h": {
          "kind": "NOT"
        },
        "k": {
          "kind": "AND"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> k.0",
        "C -> k.1",
        "k -> X"
      ]
    },
    {
      "id": "first-light-07",
      "hint": "Work out one output at a time.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        },
        "C": {
          "signal": "binary 1"
        }
      },
      "blocks": {
        "g": {
          "kind": "NOT"
        },
        "h": {
          "kind": "AND"
        },
        "k": {
          "kind": "XOR"
        },
        "m": {
          "kind": "OR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h.0",
        "B -> h.1",
        "h -> k.0",
        "C -> k.1",
        "k -> X",
        "A -> g",
        "g -> m.0",
        "B -> m.1",
        "m -> Y"
      ]
    }
  ]
}
