{
  // Chapter I: logic. Every case is one tick: inputs in, outputs out.
  // Kinds introduced: K1, K2, K3, K4, K5. See Docs/PuzzleFormat.md.
  "id": "first-light",
  "numeral": "I",
  "title": "First Light",
  "tagline": "Every box keeps a rule. Find it.",
  "circuits": [
    {
      // One box, two settings. Teaches: click to change, run to test.
      "id": "first-light-01",
      "name": "First Light",
      "hint": "Click the box to change it, then press Run.",
      "inputs": { "A": [0, 0] },
      "boxes": { "u1": { "kind": "K1", "setting": 0, "at": [1, 0] } },
      "outputs": { "X": [2, 0] },
      "wires": ["A -> u1", "u1 -> X"],
      "table": ["1 > 1"]
    },
    {
      // Two rows, so the box must do the right thing, not just make the right value.
      // Starts on "always 0", so cycling shows all four behaviours in turn.
      "id": "first-light-02",
      "name": "Two Ways",
      "hint": "Each row of the table is a test. Every row has to match.",
      "inputs": { "A": [0, 0] },
      "boxes": { "u1": { "kind": "K2", "setting": 2, "at": [1, 0] } },
      "outputs": { "X": [2, 0] },
      "wires": ["A -> u1", "u1 -> X"],
      "table": ["0 > 1", "1 > 0"]
    },
    {
      // First two-input box, in a chain. Solution: and, then invert.
      "id": "first-light-03",
      "name": "Meeting",
      "hint": "Turn on Probe and hover a box to see what goes in and what comes out.",
      "inputs": { "A": [0, 0], "B": [0, 2] },
      "boxes": {
        "g": { "kind": "K3", "setting": 0, "at": [1, 1] },
        "n": { "kind": "K1", "setting": 1, "at": [2, 1] }
      },
      "outputs": { "X": [3, 1] },
      "wires": ["A -> g.0", "B -> g.1", "g -> n", "n -> X"],
      "table": ["00 > 1", "01 > 1", "10 > 1", "11 > 0"]
    },
    {
      // One box feeds two outputs that want opposite things. Introduces K4.
      "id": "first-light-04",
      "name": "Fork",
      "hint": "Right-click a box to name what it does. Your names follow that kind of box everywhere.",
      "inputs": { "A": [0, 0], "B": [0, 2] },
      "boxes": {
        "p": { "kind": "K4", "setting": 1, "at": [1, 1] },
        "a": { "kind": "K1", "setting": 0, "at": [2, 0] },
        "b": { "kind": "K1", "setting": 0, "at": [2, 2] }
      },
      "outputs": { "X": [3, 0], "Y": [3, 2] },
      "wires": ["A -> p.0", "B -> p.1", "p -> a", "p -> b", "a -> X", "b -> Y"],
      "table": ["00 > 01", "01 > 10", "10 > 10", "11 > 01"]
    },
    {
      // Two locked boxes. The player can only shape what flows into them,
      // so they have to work out what the locked ones do first.
      "id": "first-light-05",
      "name": "Gatekeeper",
      "hint": "Dashed boxes are locked. You can't change them, only work around them.",
      "inputs": { "A": [0, 0], "B": [0, 2] },
      "boxes": {
        "a": { "kind": "K2", "setting": 0, "at": [1, 0] },
        "b": { "kind": "K2", "setting": 0, "at": [1, 2] },
        "L": { "kind": "K4", "setting": 2, "locked": true, "at": [2, 0] },
        "M": { "kind": "K3", "setting": 0, "locked": true, "at": [2, 2] }
      },
      "outputs": { "X": [3, 0], "Y": [3, 2] },
      "wires": ["A -> a", "B -> b", "a -> L.0", "b -> L.1", "a -> M.0", "b -> M.1", "L -> X", "M -> Y"],
      "table": ["00 > 01", "01 > 00", "10 > 01", "11 > 11"]
    },
    {
      // A half adder from or, and and invert: X is "exactly one", Y is "both".
      "id": "first-light-06",
      "name": "Carry",
      "inputs": { "A": [0, 0.5], "B": [0, 2.5] },
      "boxes": {
        "p": { "kind": "K3", "setting": 1, "at": [1, 0] },
        "q": { "kind": "K3", "setting": 0, "at": [1, 3] },
        "n": { "kind": "K1", "setting": 1, "at": [2, 2] },
        "r": { "kind": "K3", "setting": 0, "at": [3, 0.75] }
      },
      "outputs": { "X": [4, 0.75], "Y": [4, 3] },
      "wires": ["A -> p.0", "B -> p.1", "A -> q.0", "B -> q.1", "q -> n", "p -> r.0", "n -> r.1", "r -> X", "q -> Y"],
      "table": ["00 > 00", "01 > 10", "10 > 10", "11 > 01"]
    },
    {
      // Introduces K5, the three-input box. X: exactly two inputs on.
      "id": "first-light-07",
      "name": "Quorum",
      "inputs": { "A": [0, 0], "B": [0, 1.5], "C": [0, 3] },
      "boxes": {
        "m": { "kind": "K5", "setting": 0, "at": [1, 0.5] },
        "a": { "kind": "K5", "setting": 0, "at": [1, 2.5] },
        "n": { "kind": "K1", "setting": 1, "at": [2, 2.5] },
        "x": { "kind": "K3", "setting": 0, "at": [3, 1.5] }
      },
      "outputs": { "X": [4, 1.5] },
      "wires": [
        "A -> m.0", "B -> m.1", "C -> m.2",
        "A -> a.0", "B -> a.1", "C -> a.2",
        "a -> n", "m -> x.0", "n -> x.1", "x -> X"
      ],
      "table": ["000 > 0", "001 > 0", "010 > 0", "011 > 1", "100 > 0", "101 > 1", "110 > 1", "111 > 0"]
    },
    {
      // A full adder. S is on when an odd number of inputs are on; K when at least two are.
      "id": "first-light-08",
      "name": "Sum",
      "inputs": { "A": [0, 0], "B": [0, 1.5], "C": [0, 3] },
      "boxes": {
        "x1": { "kind": "K4", "setting": 1, "at": [1, 0.75] },
        "a1": { "kind": "K3", "setting": 0, "at": [1, 2.75] },
        "x2": { "kind": "K4", "setting": 3, "at": [2, 0.25] },
        "a2": { "kind": "K3", "setting": 0, "at": [2, 1.75] },
        "o": { "kind": "K3", "setting": 1, "at": [3, 2.25] }
      },
      "outputs": { "S": [4, 0.25], "K": [4, 2.25] },
      "wires": [
        "A -> x1.0", "B -> x1.1", "A -> a1.0", "B -> a1.1",
        "x1 -> x2.0", "C -> x2.1", "x1 -> a2.0", "C -> a2.1",
        "a2 -> o.0", "a1 -> o.1", "x2 -> S", "o -> K"
      ],
      "table": ["000 > 00", "001 > 10", "010 > 10", "011 > 01", "100 > 10", "101 > 01", "110 > 01", "111 > 11"]
    }
  ]
}
