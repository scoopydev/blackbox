// Chapter I: binary signals. See Docs/PuzzleFormat.md for the format.
// Block kinds: B1, B3, B2, B4, in the order they appear. Notes above each circuit give its solution.
{
  "id": "first-light",
  "numeral": "I",
  "title": "First Light",
  "medium": "binary",
  "tagline": "Every block keeps a rule. Find it.",
  "signals": "Signals here are bits, 0 or 1. A 1 sounds as a beep; a 0 makes none.",
  "circuits": [
    {
      // One block, two states. Solution: b on its second state.
      "id": "first-light-01",
      "name": "First Light",
      "hint": "Click the block to change what it does.",
      "probes": 0,
      "inputs": {
        "A": {"at": [0, 0], "value": 1}
      },
      "blocks": {
        "b": {"kind": "B1", "state": 0, "at": [1, 0]}
      },
      "outputs": {
        "X": {"at": [2, 0], "target": 1}
      },
      "wires": ["A -> b", "b -> X"]
    },
    {
      // Two targets. k is locked, so A has to change; b has to change.
      // Solution: A = 1, b on its second state.
      "id": "first-light-02",
      "name": "Switch",
      "hint": "Inputs with arrows can be changed: click A. A block with a padlock can't be.",
      "probes": 0,
      "inputs": {
        "A": {"at": [0, 0], "value": 0, "adjustable": true},
        "B": {"at": [0, 1], "value": 1}
      },
      "blocks": {
        "k": {"kind": "B3", "state": 1, "locked": true, "at": [1, 0]},
        "b": {"kind": "B1", "state": 0, "at": [1, 1]}
      },
      "outputs": {
        "X": {"at": [2, 0], "target": 0},
        "Y": {"at": [2, 1], "target": 1}
      },
      "wires": ["A -> k", "k -> X", "B -> b", "b -> Y"]
    },
    {
      // Introduces probes, block targets and B2. g must send 1, then k must turn it into 0.
      // Solutions: g sends 1 (and with A = B = 1, or or with either), k on invert or always 0.
      "id": "first-light-03",
      "name": "Under the Lid",
      "hint": "You can't see what a wire carries. Click a wire to put a probe on it. A target on a block is about the signal it sends.",
      "probes": 1,
      "inputs": {
        "A": {"at": [0, 0], "value": 0, "adjustable": true},
        "B": {"at": [0, 2], "value": 0, "adjustable": true}
      },
      "blocks": {
        "g": {"kind": "B2", "state": 0, "at": [1, 1], "target": 1},
        "k": {"kind": "B3", "state": 3, "at": [2, 1]}
      },
      "outputs": {
        "X": {"at": [3, 1], "target": 0}
      },
      "wires": ["A -> g.0", "B -> g.1", "g -> k", "k -> X"]
    },
    {
      // Introduces B4. g feeds both a and b. Unique solution:
      // A = 1, g = and, a = or, b = pass.
      "id": "first-light-04",
      "name": "Fork",
      "hint": "One block can feed several others. Every target has to match at the same time.",
      "probes": 1,
      "inputs": {
        "A": {"at": [0, 0], "value": 0, "adjustable": true},
        "B": {"at": [0, 2], "value": 0}
      },
      "blocks": {
        "g": {"kind": "B4", "state": 2, "at": [1, 1], "target": 0},
        "a": {"kind": "B2", "state": 0, "at": [2, 0]},
        "b": {"kind": "B1", "state": 0, "at": [2, 2]}
      },
      "outputs": {
        "X": {"at": [3, 0], "target": 1},
        "Y": {"at": [3, 2], "target": 0}
      },
      "wires": ["A -> g.0", "B -> g.1", "A -> a.0", "g -> a.1", "g -> b", "a -> X", "b -> Y"]
    },
    {
      // The inputs start on their targets. No probes: the outputs are the only window.
      // Unique solution: p = and, q = or, r = and, s = or, t = pass.
      "id": "first-light-05",
      "name": "Return",
      "hint": "A, B and C already sit where they must end. Change them to learn what the blocks do, then put them back.",
      "probes": 0,
      "inputs": {
        "A": {"at": [0, 0], "value": 1, "adjustable": true, "target": 1},
        "B": {"at": [0, 2], "value": 0, "adjustable": true, "target": 0},
        "C": {"at": [0, 4], "value": 1, "adjustable": true, "target": 1}
      },
      "blocks": {
        "p": {"kind": "B4", "state": 2, "at": [1, 1]},
        "q": {"kind": "B2", "state": 0, "at": [1, 3]},
        "r": {"kind": "B2", "state": 1, "at": [2, 0]},
        "s": {"kind": "B2", "state": 0, "at": [2, 2]},
        "t": {"kind": "B1", "state": 0, "at": [2, 4]}
      },
      "outputs": {
        "X": {"at": [3, 0], "target": 0},
        "Y": {"at": [3, 2], "target": 1},
        "Z": {"at": [3, 4], "target": 1}
      },
      "wires": ["A -> p.0", "B -> p.1", "B -> q.0", "C -> q.1", "A -> r.0", "p -> r.1", "p -> s.0", "q -> s.1", "q -> t", "r -> X", "s -> Y", "t -> Z"]
    },
    {
      // 256 combinations, one solution:
      // A = 1, B = 0, C = 1, p = and, q = invert, t = and, v = and, w = or.
      // Locked: r = invert, s = or, u = invert.
      "id": "first-light-06",
      "name": "Tangle",
      "hint": "Press D for the pen and write down what you've worked out.",
      "probes": 2,
      "inputs": {
        "A": {"at": [0, 0], "value": 0, "adjustable": true},
        "B": {"at": [0, 2], "value": 1, "adjustable": true},
        "C": {"at": [0, 4], "value": 0, "adjustable": true}
      },
      "blocks": {
        "p": {"kind": "B2", "state": 1, "at": [1, 0.5], "target": 0},
        "q": {"kind": "B1", "state": 1, "at": [1, 2.5]},
        "r": {"kind": "B1", "state": 0, "locked": true, "at": [1, 4]},
        "s": {"kind": "B4", "state": 3, "locked": true, "at": [2, 1]},
        "t": {"kind": "B2", "state": 1, "at": [2, 3]},
        "u": {"kind": "B3", "state": 1, "locked": true, "at": [3, 0]},
        "v": {"kind": "B2", "state": 0, "at": [3, 2]},
        "w": {"kind": "B2", "state": 0, "at": [3, 4]}
      },
      "outputs": {
        "X": {"at": [4, 0], "target": 0},
        "Y": {"at": [4, 2], "target": 0},
        "Z": {"at": [4, 4], "target": 1}
      },
      "wires": ["A -> p.0", "B -> p.1", "B -> q", "C -> r", "p -> s.0", "q -> s.1", "q -> t.0", "r -> t.1", "s -> u", "s -> v.0", "t -> v.1", "t -> w.0", "A -> w.1", "u -> X", "v -> Y", "w -> Z"]
    }
  ]
}
