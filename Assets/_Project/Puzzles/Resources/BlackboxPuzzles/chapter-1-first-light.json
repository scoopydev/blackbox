{
  "id": "first-light",
  "numeral": "I",
  "title": "First Light",
  "mode": "wiring",
  "medium": "binary",
  "tagline": "Every block keeps a rule. Wire it to find out.",
  "signals": "Signals here are bits, 0 or 1, and some switch between them as the loop plays. A 1 lights a light and sounds as a beep; a 0 does neither.",
  "circuits": [
    {
      "id": "first-light-01",
      "name": "First Light",
      "hint": "The wires are drawn, but one starts at the wrong input. Click the wire into g to take it off, drag from B's dot to g's left dot, then press RUN.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        }
      },
      "blocks": {
        "g": {
          "kind": "B1"
        }
      },
      "outputs": {
        "X": {
          "device": "light"
        }
      },
      "start": [
        "A -> g",
        "g -> X"
      ],
      "solution": [
        "B -> g",
        "g -> X"
      ]
    },
    {
      "id": "first-light-02",
      "name": "Switch",
      "hint": "g has two inputs and one is empty. A block with an empty input sends nothing, so wire something into it.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        }
      },
      "blocks": {
        "g": {
          "kind": "B2"
        }
      },
      "outputs": {
        "X": {
          "device": "light"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "first-light-03",
      "name": "Under the Lid",
      "hint": "Now you wire it all. You don't have to use every block, but a block only works when every one of its inputs has a wire. The dots under a block show which of its settings it is fixed in.",
      "inputs": {
        "A": {
          "signal": "binary 0110"
        },
        "B": {
          "signal": "binary 0011"
        }
      },
      "blocks": {
        "g": {
          "kind": "B3",
          "state": 1
        },
        "h": {
          "kind": "B2",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "light"
        }
      },
      "solution": [
        "A -> g",
        "g -> h.0",
        "B -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "first-light-04",
      "name": "Fork",
      "hint": "One signal can feed many wires: drag from the same dot again.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        }
      },
      "blocks": {
        "g": {
          "kind": "B4"
        },
        "h": {
          "kind": "B1"
        }
      },
      "outputs": {
        "X": {
          "device": "light"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "A -> h",
        "g -> X",
        "h -> Y"
      ]
    },
    {
      "id": "first-light-05",
      "name": "Top and Bottom",
      "hint": "Some blocks care which input is on top.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        },
        "C": {
          "signal": "binary 1"
        }
      },
      "blocks": {
        "g": {
          "kind": "B4",
          "state": 2
        },
        "h": {
          "kind": "B4",
          "state": 2
        }
      },
      "outputs": {
        "X": {
          "device": "light"
        },
        "Y": {
          "device": "light"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "B -> h.0",
        "A -> h.1",
        "g -> X",
        "h -> Y"
      ]
    },
    {
      "id": "first-light-06",
      "name": "Tangle",
      "hint": "Work out one light at a time.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        },
        "C": {
          "signal": "binary 1"
        }
      },
      "blocks": {
        "g": {
          "kind": "B1"
        },
        "h": {
          "kind": "B2"
        },
        "k": {
          "kind": "B4"
        },
        "m": {
          "kind": "B4",
          "state": 3
        }
      },
      "outputs": {
        "X": {
          "device": "light"
        },
        "Y": {
          "device": "light"
        }
      },
      "solution": [
        "A -> h.0",
        "B -> h.1",
        "h -> k.0",
        "C -> k.1",
        "k -> X",
        "A -> g",
        "g -> m.0",
        "B -> m.1",
        "m -> Y"
      ]
    }
  ]
}
