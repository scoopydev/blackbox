          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "COUNT",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X",
        "g -> h.0",
        "C -> h.1",
        "h -> Y",
        "h -> k",
        "k -> Z"
      ]
    },
    {
      "id": "blackbox-04",
      "hint": "A quiet wave can ride on a loud one. Count how often the quiet one repeats.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave sine f1 a3"
        },
        "C": {
          "signal": "decimal 6"
        },
        "D": {
          "signal": "binary 0101"
