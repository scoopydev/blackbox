{
  "id": "blackbox",
  "title": "Blackbox",
  "mode": "wiring",
  "tagline": "Everything at once.",
  "signals": "Bigger circuits with every kind of signal and block. Late in the chapter come blocks with three inputs: learn them the same way, by wiring them up and pressing RUN.",
  "guide": "recap",
  "circuits": [
    {
      "id": "blackbox-01",
      "hint": "What does a count look like to a block that reads it as a bit?",
      "inputs": {
        "A": {
          "signal": "binary 00101100"
        },
        "B": {
          "signal": "wave sine f4 a7"
        },
        "C": {
          "signal": "decimal 3"
        },
        "D": {
          "signal": "binary 01100110"
        }
      },
      "blocks": {
        "g": {
          "kind": "COUNT",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "GATE",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "AND",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> X",
        "B -> h.0",
        "g -> h.1",
        "h -> Y",
        "g -> k.0",
        "D -> k.1",
        "k -> Z"
      ]
    },
    {
      "id": "blackbox-02",
      "hint": "A wave block reads a digit as a level. What does a count look like as a level?",
      "inputs": {
        "A": {
          "signal": "binary 0101010101010101"
        },
        "B": {
          "signal": "wave sine f4 a3"
        },
        "C": {
          "signal": "decimal 6"
        },
        "D": {
          "signal": "binary 0011"
        }
      },
      "blocks": {
        "g": {
          "kind": "COUNT",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "MIX",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "MAX",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h.0",
        "B -> h.1",
        "h -> X",
        "g -> k.0",
        "C -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "blackbox-03",
      "hint": "A digit block can read two waves at once. How far apart are they?",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave saw f1 a7"
        },
        "C": {
          "signal": "decimal 4"
        },
        "D": {
          "signal": "binary 0110"
        }
      },
      "blocks": {
        "g": {
          "kind": "DIFF",
          "at": [
            1,
            0
