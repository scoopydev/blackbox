        "h": {
          "kind": "FASTER",
          "at": [
            1,
            2.5
          ]
        },
        "k": {
          "kind": "MIX",
          "at": [
            2,
            0.5
          ]
        },
        "m": {
          "kind": "COMPARE",
          "at": [
            2,
            2.5
          ]
