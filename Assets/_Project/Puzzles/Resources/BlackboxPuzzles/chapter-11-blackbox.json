    },
    {
      "id": "blackbox-06",
      "hint": "{g} is a new kind of block, with three inputs. Wire all three, then watch what it sends at each step.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        },
        "C": {
          "signal": "wave sine f1 a7"
        },
        "D": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "MAJORITY",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "NOT",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "COMPARE",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "C -> k.0",
        "D -> k.1",
        "A -> g.0",
        "B -> g.1",
        "k -> g.2",
        "g -> X",
        "g -> h",
        "h -> Y"
      ]
    },
    {
      "id": "blackbox-07",
