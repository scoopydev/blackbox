        "B": {
          "signal": "decimal 4826"
        },
        "C": {
          "signal": "decimal 2468"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIRROR"
        },
        "h": {
          "kind": "MIN"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "B -> h.0",
        "A -> h.1",
        "h -> g",
        "g -> X"
