{
  "id": "ticker",
  "numeral": "III",
  "title": "Ticker",
  "mode": "wiring",
  "medium": "decimal",
  "tagline": "Count what changes.",
  "signals": "Signals here are digits that change as the loop plays. Each one is drawn as a line whose height is the digit, 0 at the bottom up to 9 at the top, with each step's digit written on it, and each step sounds as its own tone.",
  "guide": "changing-digits",
  "circuits": [
    {
      "id": "ticker-01",
      "hint": "Now a digit can change as the loop plays: each step of the line is the next digit. A block works on each step in turn.",
      "inputs": {
        "A": {
          "signal": "decimal 1234"
        },
        "B": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> X"
      ]
    },
    {
      "id": "ticker-02",
      "hint": "Compare the target with each input, one step at a time.",
      "inputs": {
        "A": {
          "signal": "decimal 1537"
        },
        "B": {
          "signal": "decimal 4"
        }
      },
      "blocks": {
        "g": {
          "kind": "MAX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
