{
  "id": "blackbox",
  "title": "Blackbox",
  "mode": "wiring",
  "tagline": "Everything at once.",
  "signals": "Bigger circuits with every kind of signal and block. Late in the chapter come blocks with three inputs: learn them the same way, by wiring them up and pressing RUN.",
  "guide": "recap",
  "circuits": [
    {
      "id": "blackbox-01",
      "name": "Metronome",
      "hint": "Count the pulses the target makes in one loop.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "decimal 6"
        },
        "C": {
          "signal": "binary 1"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER"
        },
        "h": {
          "kind": "FASTER"
        },
        "k": {
          "kind": "COMPARE"
        },
        "m": {
          "kind": "COUNT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h",
        "h -> k.0",
        "B -> k.1",
        "k -> X",
        "k -> m",
        "m -> Y"
      ]
    },
    {
      "id": "blackbox-02",
      "name": "Mixing Desk",
      "hint": "Listen to the target. Then listen to each input on its own.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a4"
        },
        "B": {
          "signal": "wave square f2 a3"
        },
        "C": {
          "signal": "binary 0011"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIX"
        },
        "h": {
          "kind": "GATE"
        },
        "k": {
          "kind": "FLIP"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h.0",
        "C -> h.1",
        "h -> X",
        "C -> k",
        "k -> Y"
      ]
    },
    {
      "id": "blackbox-03",
      "name": "Downhill",
      "hint": "Count how many times the target's wave repeats in one loop, and which way it slopes.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "binary 1"
        },
        "C": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER"
        },
        "h": {
          "kind": "FLIP"
        },
        "k": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h",
        "h -> g",
        "g -> X",
        "C -> k",
        "k -> Y"
      ]
    },
    {
      "id": "blackbox-04",
      "name": "Signal Box",
      "hint": "One wave, read three ways: as a bit by two blocks and as a digit by another.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "decimal 9"
        }
      },
      "blocks": {
        "g": {
          "kind": "NOT"
        },
        "h": {
          "kind": "XOR"
        },
        "k": {
          "kind": "DIFF"
        },
        "m": {
          "kind": "AND"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> m.0",
        "B -> m.1",
        "m -> X",
        "A -> h.0",
        "B -> h.1",
        "h -> Z",
        "C -> k.0",
        "A -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "blackbox-05",
      "name": "Pulse Width",
      "hint": "A pulse that stays on longer comes from a lower threshold.",
      "inputs": {
        "A": {
          "signal": "wave saw f2 a7"
        },
        "B": {
          "signal": "decimal 6"
        },
        "C": {
          "signal": "decimal 2"
        }
      },
      "blocks": {
        "g": {
          "kind": "COMPARE"
        },
        "h": {
          "kind": "DIFF"
        },
        "k": {
          "kind": "COUNT"
        },
        "m": {
          "kind": "NOT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "h -> g.1",
        "B -> h.0",
        "C -> h.1",
        "g -> X",
        "g -> m",
        "m -> Y",
        "g -> k",
        "k -> Z"
      ]
    },
    {
      "id": "blackbox-06",
      "name": "Vote",
      "hint": "{g} is a new kind of block, with three inputs. Wire all three, then watch what it sends at each step.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        },
        "C": {
          "signal": "binary 0110"
        },
        "D": {
          "signal": "decimal 0"
        }
      },
      "blocks": {
        "g": {
          "kind": "MAJORITY"
        },
        "h": {
          "kind": "NOT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "C -> g.2",
        "g -> X",
        "g -> h",
        "h -> Y"
      ]
    },
    {
      "id": "blackbox-07",
      "name": "Clamp",
      "hint": "{g} is a new kind of block, with three inputs. Where does the target stop rising, and where does it start?",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "decimal 2"
        },
        "C": {
          "signal": "decimal 7"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIDDLE"
        },
        "h": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "C -> g.2",
        "g -> X",
        "g -> h",
        "h -> Y"
      ]
    },
    {
      "id": "blackbox-08",
      "name": "Window",
      "hint": "{g} is a new kind of block, with three inputs. It sends a bit: watch where the wave is each time the target turns on.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "decimal 3"
        },
        "C": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "BETWEEN"
        },
        "h": {
          "kind": "COUNT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "C -> g.2",
        "g -> X",
        "g -> h",
        "h -> Y"
      ]
    },
    {
      "id": "blackbox-09",
      "name": "Crossfade",
      "hint": "{g} is a new kind of block, with three inputs. One of them decides what it sends.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        },
        "B": {
          "signal": "wave saw f1 a7"
        },
        "C": {
          "signal": "binary 0011"
        },
        "D": {
          "signal": "binary 0101"
        }
      },
      "blocks": {
        "g": {
          "kind": "SWITCH",
          "at": [
            2,
            1.5
          ]
        },
        "h": {
          "kind": "FLIP",
          "at": [
            1,
            1
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display",
          "at": [
            3,
            1.5
          ]
        }
      },
      "solution": [
        "A -> g.0",
        "h -> g.1",
        "C -> g.2",
        "B -> h",
        "g -> X"
      ]
    },
    {
      "id": "blackbox-10",
      "name": "Black Box",
      "hint": "Solve one output at a time. X follows whichever wave is higher.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave saw f2 a5"
        },
        "C": {
          "signal": "decimal 0550"
        }
      },
      "blocks": {
        "g": {
          "kind": "COMPARE"
        },
        "h": {
          "kind": "SWITCH"
        },
        "k": {
          "kind": "COUNT"
        },
        "m": {
          "kind": "GATE"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "A -> h.0",
        "B -> h.1",
        "g -> h.2",
        "h -> X",
        "g -> k",
        "k -> Y",
        "B -> m.0",
        "C -> m.1",
        "m -> Z"
      ]
    }
  ]
}
