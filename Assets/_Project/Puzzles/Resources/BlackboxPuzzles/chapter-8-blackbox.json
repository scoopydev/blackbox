{
  "id": "blackbox",
  "title": "Blackbox",
  "mode": "wiring",
  "tagline": "Everything at once.",
  "signals": "Bigger circuits with every kind of signal and block. Make every output do what its target shows.",
  "guide": "recap",
  "circuits": [
    {
      "id": "blackbox-01",
      "name": "Metronome",
      "hint": "Count the pulses the target makes in one loop.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER"
        },
        "h": {
          "kind": "FASTER"
        },
        "k": {
          "kind": "COMPARE"
        },
        "m": {
          "kind": "COUNT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h",
        "h -> k.0",
        "B -> k.1",
        "k -> X",
        "k -> m",
        "m -> Y"
      ]
    },
    {
      "id": "blackbox-02",
      "name": "Mixing Desk",
      "hint": "Listen to the target. Then listen to each input on its own.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a4"
        },
        "B": {
          "signal": "wave square f2 a3"
        },
        "C": {
          "signal": "binary 0011"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIX"
        },
        "h": {
          "kind": "GATE"
        },
        "k": {
          "kind": "FLIP"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h.0",
        "C -> h.1",
        "h -> X",
        "C -> k",
        "k -> Y"
      ]
    },
    {
      "id": "blackbox-03",
      "name": "Downhill",
      "hint": "Count how many times the target's wave repeats in one loop, and which way it slopes.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER"
        },
        "h": {
          "kind": "FLIP"
        },
        "k": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h",
        "h -> g",
        "g -> X",
        "B -> k",
        "k -> Y"
      ]
    },
    {
      "id": "blackbox-04",
      "name": "Signal Box",
      "hint": "One wave, read three ways: as a bit by two blocks and as a digit by another.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "decimal 9"
        }
      },
      "blocks": {
        "g": {
          "kind": "NOT"
        },
        "h": {
          "kind": "XOR"
        },
        "k": {
          "kind": "DIFF"
        },
        "m": {
          "kind": "AND"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> m.0",
        "B -> m.1",
        "m -> X",
        "A -> h.0",
        "B -> h.1",
        "h -> Z",
        "C -> k.0",
        "A -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "blackbox-05",
      "name": "Pulse Width",
      "hint": "A pulse that stays on longer comes from a lower threshold.",
      "inputs": {
        "A": {
          "signal": "wave saw f2 a7"
        },
        "B": {
          "signal": "decimal 6"
        },
        "C": {
          "signal": "decimal 2"
        }
      },
      "blocks": {
        "g": {
          "kind": "COMPARE"
        },
        "h": {
          "kind": "DIFF"
        },
        "k": {
          "kind": "COUNT"
        },
        "m": {
          "kind": "NOT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "h -> g.1",
        "B -> h.0",
        "C -> h.1",
        "g -> X",
        "g -> m",
        "m -> Y",
        "g -> k",
        "k -> Z"
      ]
    },
    {
      "id": "blackbox-06",
      "name": "Black Box",
      "hint": "Solve one output at a time. Every input and every block still has to be used.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave sine f1 a7 p2"
        },
        "C": {
          "signal": "decimal 4"
        },
        "D": {
          "signal": "binary 01"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "MIX",
          "at": [
            2,
            0.5
          ]
        },
        "k": {
          "kind": "MIRROR",
          "at": [
            1,
            3
          ]
        },
        "m": {
          "kind": "GATE",
          "at": [
            2,
            2.5
          ]
        },
        "n": {
          "kind": "FASTER",
          "at": [
            1,
            1.5
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h.0",
        "B -> h.1",
        "C -> k",
        "k -> m.0",
        "D -> m.1",
        "m -> Z",
        "A -> n",
        "n -> Y",
        "h -> X"
      ]
    }
  ]
}
