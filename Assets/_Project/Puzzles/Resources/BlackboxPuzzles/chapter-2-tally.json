          "signal": "decimal 7"
        },
        "B": {
          "signal": "decimal 4"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIN"
        },
        "h": {
          "kind": "MIRROR"
        },
        "k": {
          "kind": "DIFF"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> X",
        "A -> k.0",
        "B -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "tally-05",
      "hint": "Three blocks, one after another. Work out one output at a time.",
      "inputs": {
        "A": {
          "signal": "decimal 8"
        },
        "B": {
          "signal": "decimal 3"
        },
        "C": {
          "signal": "decimal 4"
        }
      },
      "blocks": {
        "g": {
          "kind": "MAX"
        },
        "h": {
          "kind": "MIRROR"
        },
        "k": {
          "kind": "DIFF"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "C -> g.1",
        "g -> h",
        "h -> X",
        "h -> k.0",
        "B -> k.1",
        "k -> Y"
