{
  "id": "tally",
  "numeral": "II",
  "title": "Tally",
  "mode": "wiring",
  "medium": "decimal",
  "tagline": "Count what changes.",
  "signals": "Signals here are digits from 0 to 9. They wrap round, so one more than 9 is 0. A digit sounds as a short tone: the bigger the digit, the higher the tone. Digit displays show them, fans spin faster for bigger digits, and servos swing further.",
  "circuits": [
    {
      "id": "tally-01",
      "name": "Count",
      "hint": "These wires are drawn already. Run it, then move g's input to the other digit.",
      "inputs": {
        "A": {
          "signal": "decimal 4"
        },
        "B": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "D1"
        }
      },
      "outputs": {
        "X": {
          "device": "digits"
        }
      },
      "start": [
        "A -> g",
        "g -> X"
      ],
      "solution": [
        "B -> g",
        "g -> X"
      ]
    },
    {
      "id": "tally-02",
      "name": "Balance",
      "hint": "One of g's inputs is empty.",
      "inputs": {
        "A": {
          "signal": "decimal 2"
        },
        "B": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "D2"
        }
      },
      "outputs": {
        "X": {
          "device": "digits"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "tally-03",
      "name": "Reflection",
      "hint": "A fan spins faster the bigger its digit. The order the blocks come in matters.",
      "inputs": {
        "A": {
          "signal": "decimal 3"
        },
        "B": {
          "signal": "decimal 1"
        }
      },
      "blocks": {
        "g": {
          "kind": "D3",
          "state": 2
        },
        "h": {
          "kind": "D1",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "fan"
        }
      },
      "solution": [
        "A -> g",
        "g -> h",
        "h -> X"
      ]
    },
    {
      "id": "tally-04",
      "name": "Larger",
      "hint": "A servo swings its arm from left to right as its digit rises.",
      "inputs": {
        "A": {
          "signal": "decimal 8"
        },
        "B": {
          "signal": "decimal 3"
        },
        "C": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "D4"
        },
        "h": {
          "kind": "D2",
          "state": 1
        },
        "k": {
          "kind": "D1",
          "state": 2
        }
      },
      "outputs": {
        "X": {
          "device": "digits"
        },
        "Y": {
          "device": "servo"
        }
      },
      "solution": [
        "B -> g.0",
        "C -> g.1",
        "A -> h.0",
        "g -> h.1",
        "h -> X",
        "g -> k",
        "k -> Y"
      ]
    },
    {
      "id": "tally-05",
      "name": "Retrace",
      "hint": "A signal can change as the loop plays. A digit display shows each digit in turn.",
      "inputs": {
        "A": {
          "signal": "decimal 1234"
        },
        "B": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "D3",
          "state": 2
        },
        "h": {
          "kind": "D1"
        }
      },
      "outputs": {
        "X": {
          "device": "digits"
        },
        "Y": {
          "device": "fan"
        }
      },
      "solution": [
        "A -> g",
        "g -> X",
        "g -> h",
        "h -> Y"
      ]
    },
    {
      "id": "tally-06",
      "name": "Ledger",
      "hint": "Work out one output at a time.",
      "inputs": {
        "A": {
          "signal": "decimal 6"
        },
        "B": {
          "signal": "decimal 3"
        },
        "C": {
          "signal": "decimal 2468"
        }
      },
      "blocks": {
        "g": {
          "kind": "D2"
        },
        "h": {
          "kind": "D3"
        },
        "k": {
          "kind": "D4",
          "state": 1
        },
        "m": {
          "kind": "D2",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "digits"
        },
        "Y": {
          "device": "fan"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "C -> h",
        "g -> m.0",
        "h -> m.1",
        "m -> X",
        "h -> k.0",
        "B -> k.1",
        "k -> Y"
      ]
    }
  ]
}
