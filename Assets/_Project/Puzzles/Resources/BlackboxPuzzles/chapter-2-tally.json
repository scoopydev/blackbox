{
  "id": "tally",
  "numeral": "II",
  "title": "Tally",
  "mode": "wiring",
  "medium": "decimal",
  "tagline": "Count what changes.",
  "signals": "Signals here are digits from 0 to 9, drawn as a line whose height is the digit: 0 at the bottom, 9 at the top. A digit sounds as a short tone: the bigger the digit, the higher the tone.",
  "circuits": [
    {
      "id": "tally-01",
      "name": "Reflection",
      "hint": "These wires are drawn already, but X's comes straight from A. Run it, then move X's wire so it comes from {g}.",
      "inputs": {
        "A": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g",
        "A -> X"
      ],
      "solution": [
        "A -> g",
        "g -> X"
      ]
    },
    {
      "id": "tally-02",
      "name": "Balance",
      "hint": "One of {g}'s inputs is empty.",
      "inputs": {
        "A": {
          "signal": "decimal 2"
        },
        "B": {
          "signal": "decimal 7"
        }
      },
      "blocks": {
        "g": {
          "kind": "DIFF"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "tally-03",
      "name": "Peak",
      "hint": "The order the blocks come in matters.",
      "inputs": {
        "A": {
          "signal": "decimal 2"
        },
        "B": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "MAX"
        },
        "h": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> X"
      ]
    },
    {
      "id": "tally-04",
      "name": "Fork",
      "hint": "Some signals are needed in two places.",
      "inputs": {
        "A": {
          "signal": "decimal 7"
        },
        "B": {
          "signal": "decimal 4"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIN"
        },
        "h": {
          "kind": "MIRROR"
        },
        "k": {
          "kind": "DIFF"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> X",
        "A -> k.0",
        "B -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "tally-05",
      "name": "Retrace",
      "hint": "A signal can change as the loop plays: each step of the line is the next digit.",
      "inputs": {
        "A": {
          "signal": "decimal 1234"
        },
        "B": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIRROR"
        },
        "h": {
          "kind": "DIFF"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> X",
        "A -> h.0",
        "B -> h.1",
        "h -> Y"
      ]
    },
    {
      "id": "tally-06",
      "name": "Ledger",
      "hint": "Work out one output at a time.",
      "inputs": {
        "A": {
          "signal": "decimal 6"
        },
        "B": {
          "signal": "decimal 3"
        },
        "C": {
          "signal": "decimal 2468"
        }
      },
      "blocks": {
        "g": {
          "kind": "DIFF"
        },
        "h": {
          "kind": "MIRROR"
        },
        "k": {
          "kind": "MAX"
        },
        "m": {
          "kind": "MIN"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "C -> h",
        "g -> m.0",
        "h -> m.1",
        "m -> X",
        "h -> k.0",
        "B -> k.1",
        "k -> Y"
      ]
    }
  ]
}
