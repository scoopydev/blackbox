{
  "id": "tally",
  "numeral": "II",
  "title": "Tally",
  "mode": "wiring",
  "medium": "decimal",
  "tagline": "Every digit holds steady.",
  "signals": "Signals here are digits, whole numbers from 0 to 9. Each one stays the same all loop long, so it's shown as just its number. A digit sounds as a short tone: the bigger the digit, the higher the tone.",
  "circuits": [
    {
      "id": "tally-01",
      "hint": "These wires are drawn already. Run it, then move {g}'s input to the other digit.",
      "inputs": {
        "A": {
          "signal": "decimal 4"
        },
        "B": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g",
        "g -> X"
      ],
      "solution": [
        "B -> g",
        "g -> X"
      ]
    },
    {
      "id": "tally-02",
      "hint": "One of {g}'s inputs is empty.",
      "inputs": {
        "A": {
          "signal": "decimal 2"
        },
        "B": {
          "signal": "decimal 7"
        }
      },
      "blocks": {
        "g": {
          "kind": "DIFF"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "tally-03",
      "hint": "The order the blocks come in matters.",
      "inputs": {
        "A": {
          "signal": "decimal 6"
        },
        "B": {
          "signal": "decimal 8"
        },
        "C": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "DIFF"
        },
        "h": {
          "kind": "MAX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h.0",
        "B -> h.1",
        "h -> g.0",
        "C -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "tally-04",
      "hint": "Some signals are needed in two places.",
      "inputs": {
