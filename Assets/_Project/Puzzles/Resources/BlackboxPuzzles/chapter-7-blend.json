{
  "id": "blend",
  "title": "Blend",
  "mode": "wiring",
  "tagline": "Signals of different kinds, mixed together.",
  "signals": "A bit block reads a wave as 1 while it's above the middle. The new blocks work on any signal: they add, flip, delay, gate, count, speed up and compare.",
  "circuits": [
    {
      "id": "blend-01",
      "name": "Pulse",
      "hint": "A wave into a bit block turns on and off as the wave rises and falls.",
      "inputs": {
        "A": {
          "signal": "binary 1"
        },
        "B": {
          "signal": "wave sine f2 a7"
        },
        "C": {
          "signal": "wave sine f3 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "B2"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "C -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "blend-02",
      "name": "Silence",
      "hint": "{g} is a new kind of block. Two waves can cancel each other out.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        },
        "B": {
          "signal": "wave sine f2 a7 p2"
        },
        "C": {
          "signal": "wave sine f2 a7 p1"
        }
      },
      "blocks": {
        "g": {
          "kind": "M1"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "blend-03",
      "name": "Mirror",
      "hint": "{g} is a new kind of block. A signal and its mirror image add up to nothing.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "M2"
        },
        "h": {
          "kind": "M1"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "A -> h.0",
        "g -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "blend-04",
      "name": "Late",
      "hint": "{g} is a new kind of block. How much later is a quarter of a loop, for a fast wave and a slow one?",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave sine f2 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "M3"
        },
        "h": {
          "kind": "M1"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "B -> g",
        "B -> h.0",
        "g -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "blend-05",
      "name": "Double Time",
      "hint": "{h} is a new kind of block. The order the blocks come in matters.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave saw f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "M3"
        },
        "h": {
          "kind": "M7"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "B -> h",
        "h -> g",
        "g -> X"
      ]
    },
    {
      "id": "blend-06",
      "name": "Burst",
      "hint": "{g} is a new kind of block. Listen to the target, then to what you make.",
      "inputs": {
        "A": {
          "signal": "wave saw f3 a7"
        },
        "B": {
          "signal": "binary 0110"
        }
      },
      "blocks": {
        "g": {
          "kind": "M5"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "blend-07",
      "name": "Count",
      "hint": "{g} is a new kind of block. Watch the target's digit change through the loop.",
      "inputs": {
        "A": {
          "signal": "wave sine f4 a7"
        },
        "B": {
          "signal": "binary 0110"
        }
      },
      "blocks": {
        "g": {
          "kind": "M6"
        },
        "h": {
          "kind": "M5"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h.0",
        "B -> h.1",
        "h -> g",
        "g -> X"
      ]
    },
    {
      "id": "blend-08",
      "name": "Threshold",
      "hint": "{g} is a new kind of block. A digit read as a wave is a height: 0 at the bottom, 9 at the top. The target stays at 1 for longer when the height is lower.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "decimal 7"
        },
        "C": {
          "signal": "decimal 2"
        }
      },
      "blocks": {
        "g": {
          "kind": "M8"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    }
  ]
}
