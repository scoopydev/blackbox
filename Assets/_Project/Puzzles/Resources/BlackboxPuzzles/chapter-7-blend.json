{
  "id": "blend",
  "title": "Blend",
  "mode": "wiring",
  "tagline": "Signals of different kinds, mixed together.",
  "signals": "A bit block reads a wave as 1 while it's above the middle, and a wave block reads a bit as a wave at the top for 1 and the bottom for 0. A block from Resonance comes back with a bit pattern, and two new blocks work on any signal: one counts and one compares.",
  "circuits": [
    {
      "id": "blend-01",
      "hint": "A wave block reads a bit as the top for 1 and the bottom for 0, so a bit pattern can become a square wave.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "wave sine f1 a7"
        },
        "D": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER"
        },
        "h": {
          "kind": "FLIP"
        },
        "k": {
          "kind": "MIX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> X",
        "B -> h",
        "h -> k.0",
        "C -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "blend-02",
      "hint": "A wave into a bit block turns on and off as the wave rises and falls. A bit into a wave block is the top or the bottom.",
      "inputs": {
        "A": {
          "signal": "binary 0110"
        },
        "B": {
          "signal": "wave sine f3 a7"
        },
        "C": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "AND"
        },
        "h": {
          "kind": "FLIP"
        },
        "k": {
          "kind": "MIX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "C -> k.0",
        "h -> k.1",
        "k -> X"
      ]
    },
    {
      "id": "blend-03",
      "hint": "Two waves can cancel each other out. How could a wave cancel itself?",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "decimal 9"
        },
        "D": {
          "signal": "wave saw f2 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "MIX",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "MIX",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "A -> h.0",
        "g -> h.1",
        "h -> k.0",
        "B -> k.1",
        "k -> X"
      ]
    },
    {
      "id": "blend-04",
      "hint": "No block here turns a digit around. Read a digit as a level and turn it upside down: what digit comes back?",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "decimal 2"
        },
        "C": {
          "signal": "binary 0011"
        },
        "D": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "FLIP",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "MIN",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "MIX",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "B -> g",
        "A -> h.0",
        "g -> h.1",
        "h -> X",
        "h -> k.0",
        "C -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "blend-05",
      "hint": "You met {g}'s kind in Resonance, with two waves. Here its bottom input is a bit pattern, but not one you've been given: how could you turn one over?",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "binary 1"
        },
        "D": {
          "signal": "decimal 0"
        }
      },
      "blocks": {
        "g": {
          "kind": "GATE",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "FASTER",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "XOR",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h",
        "h -> g.0",
        "B -> k.0",
        "C -> k.1",
        "k -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "blend-06",
      "hint": "{g} is a new kind of block. Can a digit go down while a count goes up?",
      "inputs": {
        "A": {
          "signal": "wave sine f4 a7"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "binary 1"
        },
        "D": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "COUNT",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "GATE",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "DIFF",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h.0",
        "B -> h.1",
        "h -> X",
        "h -> g",
        "g -> k.0",
        "D -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "blend-07",
      "hint": "{g} is a new kind of block. A digit read as a wave is a height: 0 at the bottom, 9 at the top. The height you need isn't one of the inputs.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "decimal 2"
        },
        "C": {
          "signal": "binary 0110"
        },
        "D": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "COMPARE",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "MIRROR",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "AND",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> h",
        "h -> g.1",
        "g -> k.0",
        "C -> k.1",
        "k -> X"
      ]
    },
    {
      "id": "blend-08",
      "hint": "One block's signal can feed two other blocks at once. Four blocks, two outputs.",
      "inputs": {
        "A": {
          "signal": "wave sine f3 a7"
        },
        "B": {
          "signal": "decimal 7"
        },
        "C": {
          "signal": "decimal 8"
        },
        "D": {
          "signal": "wave saw f1 a5"
        }
      },
      "blocks": {
        "g": {
          "kind": "COMPARE",
          "at": [
            1,
            0.5
          ]
        },
        "h": {
          "kind": "COUNT",
          "at": [
            1,
            2.5
          ]
        },
        "k": {
          "kind": "GATE",
          "at": [
            2,
            0.5
          ]
        },
        "m": {
          "kind": "FASTER",
          "at": [
            2,
            2.5
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> Y",
        "D -> m",
        "m -> k.0",
        "g -> k.1",
        "k -> X"
      ]
    }
  ]
}
