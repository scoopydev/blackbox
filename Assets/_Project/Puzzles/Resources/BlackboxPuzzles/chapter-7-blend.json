{
  "id": "blend",
  "title": "Blend",
  "mode": "wiring",
  "tagline": "Signals of different kinds, mixed together.",
  "signals": "A bit block reads a wave as 1 while it's above the middle, and a wave block reads a bit as a wave at the top for 1 and the bottom for 0. The new blocks work on any signal: they let a signal through, count, and compare.",
  "circuits": [
    {
      "id": "blend-01",
      "hint": "A wave into a bit block turns on and off as the wave rises and falls. A bit into a wave block is the top or the bottom.",
      "inputs": {
        "A": {
          "signal": "binary 0110"
        },
        "B": {
          "signal": "wave sine f3 a7"
        },
        "C": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "AND"
        },
        "h": {
          "kind": "FLIP"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> X"
      ]
    },
    {
      "id": "blend-02",
      "hint": "Two waves can cancel each other out.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        },
        "B": {
          "signal": "wave sine f2 a7 p2"
        },
        "C": {
          "signal": "wave square f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIX"
        },
        "h": {
          "kind": "MIX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h.0",
        "C -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "blend-03",
      "hint": "A wave block reads a bit as a wave: at the top for 1, at the bottom for 0.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "wave sine f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER"
        },
        "h": {
          "kind": "FLIP"
        },
        "k": {
          "kind": "MIX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> X",
        "B -> h",
        "h -> k.0",
        "C -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "blend-04",
      "hint": "One input can feed two blocks. What does a wave mixed with a late copy of itself look like?",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave sine f2 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER"
        },
        "h": {
          "kind": "MIX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "A -> h.0",
        "g -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "blend-05",
      "hint": "{g} is a new kind of block. Listen to the target, then to what you make.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "decimal 4"
        }
      },
      "blocks": {
        "g": {
          "kind": "GATE"
        },
        "h": {
          "kind": "FASTER"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h",
        "h -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "blend-06",
      "hint": "{g} is a new kind of block. Watch the target's digit change through the loop.",
      "inputs": {
        "A": {
          "signal": "wave sine f4 a7"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "binary 1"
        }
      },
      "blocks": {
        "g": {
          "kind": "COUNT"
        },
        "h": {
          "kind": "GATE"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h.0",
        "B -> h.1",
        "h -> X",
        "h -> g",
        "g -> Y"
      ]
    },
    {
      "id": "blend-07",
      "hint": "{g} is a new kind of block. A digit read as a wave is a height: 0 at the bottom, 9 at the top. The target stays at 1 for longer when the height is lower.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "decimal 2"
        },
        "C": {
          "signal": "binary 0011"
        }
      },
      "blocks": {
        "g": {
          "kind": "COMPARE"
        },
        "h": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "h -> g.1",
        "B -> h",
        "g -> X"
      ]
    },
    {
      "id": "blend-08",
      "hint": "One block's signal can feed an output and another block at once.",
      "inputs": {
        "A": {
          "signal": "wave sine f3 a7"
        },
        "B": {
          "signal": "decimal 4"
        },
        "C": {
          "signal": "decimal 8"
        }
      },
      "blocks": {
        "g": {
          "kind": "COMPARE"
        },
        "h": {
          "kind": "COUNT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "C -> g.1",
        "g -> X",
        "g -> h",
        "h -> Y"
      ]
    }
  ]
}
