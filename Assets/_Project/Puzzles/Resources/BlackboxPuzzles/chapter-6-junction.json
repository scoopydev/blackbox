{
  "id": "junction",
  "title": "Junction",
  "mode": "wiring",
  "tagline": "Where kinds of signal meet.",
  "signals": "Every circuit here brings two kinds of signal into one block, and the block reads each one as its own kind: a bit block sees a digit as 1 unless it's 0 and a wave as 1 while it's above the middle; a digit block sees a bit as 0 or 1 and a wave as its height above the middle, up to its A; a wave block sees a bit as the top or the bottom, and a digit as a level.",
  "circuits": [
    {
      "id": "junction-01",
      "hint": "Two kinds of signal can meet in one block. A bit block reads a digit as 1 unless it's 0, and a wave as 1 while it's above the middle.",
      "inputs": {
        "A": {
          "signal": "decimal 0505"
        },
        "B": {
          "signal": "binary 0011"
        },
        "C": {
          "signal": "wave square f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "AND"
        },
        "h": {
          "kind": "XOR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h.0",
        "C -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "junction-02",
      "hint": "The same blocks in a different order can send something different.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a4"
        },
        "B": {
          "signal": "binary 0110"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIX",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "LATER",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "FASTER",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> k",
        "k -> X"
      ]
    },
    {
      "id": "junction-03",
      "hint": "A bit block reads a wave as 1 while it's above the middle. What lights up where a pattern meets its own late copy?",
      "inputs": {
        "A": {
          "signal": "binary 01101000"
        },
        "B": {
          "signal": "wave saw f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER"
        },
        "h": {
          "kind": "XOR"
        },
        "k": {
          "kind": "AND"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "A -> h.0",
        "g -> h.1",
        "h -> X",
        "h -> k.0",
        "B -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "junction-04",
      "hint": "One input can feed two blocks. A digit block reads a wave by its height above the middle.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "decimal 3"
        }
      },
      "blocks": {
        "g": {
          "kind": "MAX",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "DIFF",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "MIRROR",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h.0",
        "B -> h.1",
        "h -> k",
        "k -> X"
      ]
    },
    {
      "id": "junction-05",
      "hint": "A digit block reads a bit as the digit 0 or 1, so a bit taken away from a digit takes off 0 or 1.",
      "inputs": {
        "A": {
          "signal": "decimal 7"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "wave saw f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "DIFF"
        },
        "h": {
          "kind": "MIRROR"
        },
        "k": {
          "kind": "MIN"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> k.0",
        "C -> k.1",
        "k -> X"
      ]
    },
    {
      "id": "junction-06",
      "hint": "One block's signal can feed an output and another block at once. Work out one output at a time.",
      "inputs": {
        "A": {
          "signal": "decimal 6"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "wave sine f2 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "DIFF"
        },
        "h": {
          "kind": "MIX"
        },
        "k": {
          "kind": "MIN"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X",
        "C -> h.0",
        "B -> h.1",
        "h -> Y",
        "g -> k.0",
        "C -> k.1",
        "k -> Z"
      ]
    }
  ]
}
