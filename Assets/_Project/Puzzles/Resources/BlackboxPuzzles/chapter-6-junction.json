{
  "id": "junction",
  "title": "Junction",
  "mode": "wiring",
  "tagline": "Where kinds of signal meet.",
  "signals": "Every circuit here brings two kinds of signal into one block, and the block reads each one as its own kind: a bit block sees a digit as 1 unless it's 0 and a wave as 1 while it's above the middle; a digit block sees a bit as 0 or 1 and a wave as 0 at the bottom up to 9 at the top; a wave block sees a bit as the top or the bottom, and a digit as a level.",
  "circuits": [
    {
      "id": "junction-01",
      "hint": "A rhythm: beep, rest, beep beep. A bit block reads a digit as 1 unless it's 0, and a wave as 1 while it's above the middle.",
      "inputs": {
        "A": {
          "signal": "decimal 0505"
        },
        "B": {
          "signal": "binary 0011"
        },
        "C": {
          "signal": "wave square f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "AND"
        },
        "h": {
          "kind": "XOR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h.0",
        "C -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "junction-02",
      "hint": "A wave riding up and down on a square, twice as fast as the inputs. A wave block reads a bit as the top for 1 and the bottom for 0.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a4"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "decimal 9"
        },
        "D": {
          "signal": "binary 1"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIX",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "LATER",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "FASTER",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> k",
        "k -> X"
      ]
    },
    {
      "id": "junction-03",
      "hint": "A ramp that climbs until it hits a ceiling. A digit block reads a bit as the digit 0 or 1, and a wave by its height: 0 at the bottom up to 9 at the top.",
