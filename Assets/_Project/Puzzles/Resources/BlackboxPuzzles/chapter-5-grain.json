// Chapter V: sampled wave signals. See Docs/PuzzleFormat.md for the format.
// Block kinds: Q1, Q2, Q3, Q4. Notes above each circuit give its solution.
{
  "id": "grain",
  "numeral": "V",
  "title": "Grain",
  "medium": "sampled",
  "tagline": "Up close, every curve is a staircase.",
  "signals": "Signals here are sampled waves: a wave read a few times a cycle, rounded to a whole level and held, so it moves in steps. F and A work as for waves; S, 3, 6 or 12, is how many steps make one cycle. They sound buzzy, the more so the fewer the steps.",
  "circuits": [
    {
      // Introduces Q1. Solution: u = more steps, v = fewer steps.
      "id": "grain-01",
      "name": "Stairs",
      "hint": "A sampled wave is read a few times a cycle and held in steps. S is how many steps make one cycle.",
      "probes": 0,
      "inputs": {
        "A": {"at": [0, 0], "value": "sine f1 a7 s3"},
        "B": {"at": [0, 1], "value": "sine f2 a6 s12"}
      },
      "blocks": {
        "u": {"kind": "Q1", "state": 1, "at": [1, 0]},
        "v": {"kind": "Q1", "state": 0, "at": [1, 1]}
      },
      "outputs": {
        "X": {"at": [2, 0], "target": "sine f1 a7 s6"},
        "Y": {"at": [2, 1], "target": "sine f2 a6 s6"}
      },
      "wires": ["A -> u", "u -> X", "B -> v", "v -> Y"]
    },
    {
      // Introduces Q2. w is locked on taller, so A = saw f3 a4 s12. x = shorter.
      "id": "grain-02",
      "name": "Level",
      "hint": "You can't change a locked block, but you can change what goes into it.",
      "probes": 0,
      "inputs": {
        "A": {"at": [0, 0], "value": "saw f2 a4 s12", "adjustable": true, "options": ["saw f2 a4 s12", "saw f3 a4 s12", "saw f4 a4 s12"]},
        "B": {"at": [0, 1], "value": "sine f1 a5 s12"}
      },
      "blocks": {
        "w": {"kind": "Q2", "state": 0, "locked": true, "at": [1, 0]},
        "x": {"kind": "Q2", "state": 0, "at": [1, 1]}
      },
      "outputs": {
        "X": {"at": [2, 0], "target": "saw f3 a5 s12"},
        "Y": {"at": [2, 1], "target": "sine f1 a4 s12"}
      },
      "wires": ["A -> w", "w -> X", "B -> x", "x -> Y"]
    },
    {
      // Introduces Q3. k is locked on shorter, so g must send saw f2 a7 s12:
      // g = top's wave with bottom's steps, B = sine f5 a3 s12.
      "id": "grain-03",
      "name": "Graft",
      "hint": "Two waves in, one out. A probe shows what the block made.",
      "probes": 1,
      "inputs": {
        "A": {"at": [0, 0], "value": "saw f2 a7 s3"},
        "B": {"at": [0, 2], "value": "sine f5 a3 s3", "adjustable": true, "options": ["sine f5 a3 s3", "sine f5 a3 s6", "sine f5 a3 s12"]}
      },
      "blocks": {
        "g": {"kind": "Q3", "state": 1, "at": [1, 1]},
        "k": {"kind": "Q2", "state": 1, "locked": true, "at": [2, 1]}
      },
      "outputs": {
        "X": {"at": [3, 1], "target": "saw f2 a6 s12"}
      },
      "wires": ["A -> g.0", "B -> g.1", "g -> k", "k -> X"]
    },
    {
      // Introduces Q4, locked on the taller. Unique solution:
      // A = sine f2 a5 s6, B = saw f3 a6 s12, a = top's wave with bottom's steps, b = fewer steps.
      "id": "grain-04",
      "name": "Measure",
      "hint": "The padlocked block compares. Feed it different waves to find out how.",
      "probes": 1,
      "inputs": {
        "A": {"at": [0, 0], "value": "sine f2 a3 s6", "adjustable": true, "options": ["sine f2 a3 s6", "sine f2 a5 s6", "sine f2 a7 s6"]},
        "B": {"at": [0, 2], "value": "saw f3 a6 s12", "adjustable": true, "options": ["saw f3 a4 s12", "saw f3 a6 s12"]}
      },
      "blocks": {
        "g": {"kind": "Q4", "state": 0, "locked": true, "at": [1, 1]},
        "a": {"kind": "Q3", "state": 0, "at": [2, 0]},
        "b": {"kind": "Q1", "state": 0, "at": [2, 2]}
      },
      "outputs": {
        "X": {"at": [3, 0], "target": "sine f2 a5 s12"},
        "Y": {"at": [3, 2], "target": "saw f3 a6 s6"}
      },
      "wires": ["A -> g.0", "B -> g.1", "A -> a.0", "g -> a.1", "g -> b", "a -> X", "b -> Y"]
    },
    {
      // Unique solution: p = fewer steps, q = the taller, r = bottom's wave with top's steps, s = one level shorter.
      "id": "grain-05",
      "name": "Replay",
      "hint": "A and B already sit where they must end. Change them to learn what the blocks do, then put them back.",
      "probes": 0,
      "inputs": {
        "A": {"at": [0, 0.5], "value": "sine f3 a4 s6", "adjustable": true, "options": ["sine f3 a4 s6", "sine f3 a6 s6", "sine f3 a4 s12"], "target": "sine f3 a4 s6"},
        "B": {"at": [0, 2.5], "value": "saw f2 a6 s12", "adjustable": true, "options": ["saw f2 a3 s12", "saw f2 a6 s12"], "target": "saw f2 a6 s12"}
      },
      "blocks": {
        "p": {"kind": "Q1", "state": 0, "at": [1, 0]},
        "q": {"kind": "Q4", "state": 0, "at": [1, 2]},
        "r": {"kind": "Q3", "state": 0, "at": [2, 1]},
        "s": {"kind": "Q2", "state": 0, "at": [2, 3]}
      },
      "outputs": {
        "X": {"at": [3, 0], "target": "sine f3 a4 s3"},
        "Y": {"at": [3, 1], "target": "saw f2 a6 s3"},
        "Z": {"at": [3, 3], "target": "saw f2 a5 s12"}
      },
      "wires": ["A -> p", "A -> q.0", "B -> q.1", "p -> r.0", "q -> r.1", "q -> s", "p -> X", "r -> Y", "s -> Z"]
    },
    {
      // 288 combinations, one solution:
      // A = sine f2 a7 s6, B = saw f4 a6 s3, p = the taller, q = one level shorter,
      // s = top's wave with bottom's steps, v = top's wave with bottom's steps, w = one level taller.
      // Locked: r = more steps, t = the taller, u = more steps.
      "id": "grain-06",
      "name": "Mosaic",
      "hint": "The last circuit. Listen, probe and take notes.",
      "probes": 2,
      "inputs": {
        "A": {"at": [0, 0], "value": "sine f2 a5 s6", "adjustable": true, "options": ["sine f2 a5 s6", "sine f2 a5 s12", "sine f2 a7 s6"]},
        "B": {"at": [0, 2], "value": "saw f4 a6 s12", "adjustable": true, "options": ["saw f4 a3 s12", "saw f4 a6 s12", "saw f4 a6 s3"]},
        "C": {"at": [0, 4], "value": "sine f1 a6 s12"}
      },
      "blocks": {
        "p": {"kind": "Q4", "state": 0, "at": [1, 0.5]},
        "q": {"kind": "Q2", "state": 0, "at": [1, 2.5]},
        "r": {"kind": "Q1", "state": 0, "locked": true, "at": [1, 4]},
        "s": {"kind": "Q3", "state": 1, "at": [2, 1]},
        "t": {"kind": "Q4", "state": 0, "locked": true, "at": [2, 3]},
        "u": {"kind": "Q1", "state": 0, "locked": true, "at": [3, 0]},
        "v": {"kind": "Q3", "state": 1, "at": [3, 2]},
        "w": {"kind": "Q2", "state": 1, "at": [3, 4]}
      },
      "outputs": {
        "X": {"at": [4, 0], "target": "sine f2 a7 s6"},
        "Y": {"at": [4, 2], "target": "sine f2 a7 s3"},
        "Z": {"at": [4, 4], "target": "sine f1 a7 s3"}
      },
      "wires": ["A -> p.0", "B -> p.1", "B -> q", "C -> r", "p -> s.0", "q -> s.1", "q -> t.0", "r -> t.1", "s -> u", "s -> v.0", "t -> v.1", "t -> w", "u -> X", "v -> Y", "w -> Z"]
    }
  ]
}
