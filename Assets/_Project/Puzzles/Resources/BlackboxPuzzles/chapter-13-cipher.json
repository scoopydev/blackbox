          "kind": "MIN"
        },
        "h": {
          "kind": "DIFF"
        },
        "k": {
          "kind": "DIFF"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h.0",
        "B -> h.1",
        "A -> k.0",
        "C -> k.1",
        "h -> g.0",
        "k -> g.1",
        "g -> X"
      ]
    },
    {
