{
  "id": "unmarked",
  "title": "Unmarked",
  "mode": "wiring",
  "tagline": "Every block you've met, all mixed up.",
  "signals": "From here on, any kind of signal and any block you've met can turn up anywhere, so try things and watch what each block sends.",
  "guide": "recap",
  "circuits": [
    {
      "id": "unmarked-01",
      "hint": "Try feeding a block a signal and that same signal turned around.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "decimal 4"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIRROR"
        },
        "h": {
          "kind": "MIN"
        },
        "k": {
          "kind": "MAX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "A -> h.0",
        "g -> h.1",
        "h -> X",
        "B -> k.0",
        "g -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "unmarked-02",
      "hint": "One input can feed the first block of a chain and the last.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        },
        "B": {
          "signal": "decimal 4"
        }
      },
      "blocks": {
        "g": {
          "kind": "COMPARE"
        },
        "h": {
          "kind": "FLIP"
        },
        "k": {
          "kind": "MIX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> X",
        "A -> k.0",
        "h -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "unmarked-03",
      "hint": "Count how often the target beats, and how often the input's wave repeats.",
      "inputs": {
        "A": {
          "signal": "wave sine f4 a9"
        },
        "B": {
          "signal": "decimal 8"
        },
        "C": {
          "signal": "binary 11001100"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "COMPARE",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "AND",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h.0",
        "B -> h.1",
        "h -> k.0",
        "C -> k.1",
        "k -> X"
      ]
    },
    {
      "id": "unmarked-04",
      "hint": "One block can cut off a signal's top and another its bottom. Y needs an input that X uses too.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "decimal 2"
        },
        "C": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIN"
        },
        "h": {
          "kind": "MAX"
        },
        "k": {
          "kind": "COMPARE"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "C -> g.1",
        "g -> h.0",
        "B -> h.1",
        "h -> X",
        "A -> k.0",
        "C -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "unmarked-05",
      "hint": "Try one signal in both of a block's inputs.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "GATE"
        },
        "h": {
          "kind": "GATE"
        },
        "k": {
          "kind": "FLIP"
        },
        "m": {
          "kind": "MIX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "A -> g.1",
        "A -> k",
        "k -> h.0",
        "k -> h.1",
        "g -> m.0",
        "h -> m.1",
        "m -> X"
      ]
    },
    {
      "id": "unmarked-06",
      "hint": "No block here turns a wave upside down, but the target needs one that is. What else changes where a wave is in the loop?",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave saw f1 a7"
        },
        "C": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER",
          "at": [
            1,
            0.5
          ]
        },
        "h": {
          "kind": "LATER",
          "at": [
            1,
            2.5
          ]
        },
        "k": {
          "kind": "MIX",
          "at": [
            2,
            0.5
          ]
        },
        "m": {
          "kind": "COMPARE",
          "at": [
            2,
            2.5
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h",
        "h -> k.0",
        "B -> k.1",
        "k -> X",
        "k -> m.0",
        "C -> m.1",
        "m -> Y"
      ]
    },
    {
      "id": "unmarked-07",
      "hint": "Solve one output at a time. Every block still has to be used.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave sine f1 a7 p2"
        },
        "C": {
          "signal": "decimal 2"
        },
        "D": {
          "signal": "binary 01"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "MIX",
          "at": [
            2,
            0.5
          ]
        },
        "k": {
          "kind": "MIRROR",
          "at": [
            1,
            3
          ]
        },
        "m": {
          "kind": "GATE",
          "at": [
            2,
            2.5
          ]
        },
        "n": {
          "kind": "FASTER",
          "at": [
            1,
            1.5
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h.0",
        "B -> h.1",
        "C -> k",
        "k -> m.0",
        "D -> m.1",
        "m -> Z",
        "A -> n",
        "n -> Y",
        "h -> X"
      ]
    }
  ]
}
