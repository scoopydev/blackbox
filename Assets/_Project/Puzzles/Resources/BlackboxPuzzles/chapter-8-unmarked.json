{
  "id": "unmarked",
  "title": "Unmarked",
  "mode": "wiring",
  "tagline": "Every block you've met, all mixed up.",
  "signals": "From here on, any kind of signal and any block you've met can turn up anywhere, so try things and watch what each block sends.",
  "guide": "recap",
  "circuits": [
    {
      "id": "unmarked-01",
      "hint": "Fold the ramp into a valley, then turn the valley into a hill with a flat top.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "decimal 5"
        },
        "C": {
          "signal": "decimal 7"
        }
      },
      "blocks": {
        "g": {
          "kind": "DIFF"
        },
        "h": {
          "kind": "MIRROR"
        },
        "k": {
          "kind": "MIN"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X",
        "g -> h",
        "h -> k.0",
        "C -> k.1",
        "k -> Y"
      ]
    },
    {
