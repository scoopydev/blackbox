{
  "id": "unmarked",
  "title": "Unmarked",
  "mode": "wiring",
  "tagline": "Every block you've met, all mixed up.",
  "signals": "From here on, any kind of signal and any block you've met can turn up anywhere, so try things and watch what each block sends.",
  "guide": "recap",
  "circuits": [
    {
      "id": "unmarked-01",
      "hint": "The only way to learn a block is to wire it up and press RUN.",
      "inputs": {
        "A": {
          "signal": "decimal 4"
        },
        "B": {
          "signal": "decimal 7"
        }
      },
      "blocks": {
        "g": {
          "kind": "MAX"
        },
        "h": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> X"
      ]
    },
    {
      "id": "unmarked-02",
      "hint": "Two inputs, two blocks, two outputs. Try each block with each input.",
      "inputs": {
        "A": {
          "signal": "decimal 2"
        },
        "B": {
          "signal": "binary 0110"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIRROR"
        },
        "h": {
          "kind": "NOT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "B -> h",
        "g -> X",
        "h -> Y"
      ]
    },
    {
      "id": "unmarked-03",
      "hint": "Look at how often the target's wave repeats, and where it starts.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "binary 0101"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER"
        },
        "h": {
          "kind": "FASTER"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h",
        "h -> g",
        "g -> X"
      ]
    },
    {
      "id": "unmarked-04",
      "hint": "Two outputs, two blocks. Each block has to lead to an output, through other blocks or straight there.",
      "inputs": {
        "A": {
          "signal": "binary 1"
        },
        "B": {
          "signal": "wave sine f4 a7"
        },
        "C": {
          "signal": "decimal 0"
        }
      },
      "blocks": {
        "g": {
          "kind": "AND"
        },
        "h": {
          "kind": "NOT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "h -> X",
        "g -> Y"
      ]
    },
    {
      "id": "unmarked-05",
      "hint": "Watch the target's digits change through the loop.",
      "inputs": {
        "A": {
          "signal": "wave sine f3 a7"
        },
        "B": {
          "signal": "decimal 9"
        }
      },
      "blocks": {
        "g": {
          "kind": "COUNT"
        },
        "h": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h",
        "h -> X"
      ]
    },
    {
      "id": "unmarked-06",
      "hint": "One block's signal can feed an output and another block at once.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        }
      },
      "blocks": {
        "g": {
          "kind": "XOR"
        },
        "h": {
          "kind": "MIRROR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X",
        "g -> h",
        "h -> Y"
      ]
    },
    {
      "id": "unmarked-07",
      "hint": "Solve one output at a time. Every block still has to be used.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave sine f1 a7 p2"
        },
        "C": {
          "signal": "decimal 2"
        },
        "D": {
          "signal": "binary 01"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "MIX",
          "at": [
            2,
            0.5
          ]
        },
        "k": {
          "kind": "MIRROR",
          "at": [
            1,
            3
          ]
        },
        "m": {
          "kind": "GATE",
          "at": [
            2,
            2.5
          ]
        },
        "n": {
          "kind": "FASTER",
          "at": [
            1,
            1.5
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h.0",
        "B -> h.1",
        "C -> k",
        "k -> m.0",
        "D -> m.1",
        "m -> Z",
        "A -> n",
        "n -> Y",
        "h -> X"
      ]
    }
  ]
}
