        "B": {
          "signal": "shape hollow green square"
        }
      },
      "blocks": {
        "g": {
          "kind": "S4",
          "state": 1
        },
        "h": {
          "kind": "S2",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "light"
        },
        "Y": {
          "device": "digits"
