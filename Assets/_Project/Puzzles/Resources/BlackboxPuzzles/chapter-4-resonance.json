    {
      "id": "resonance-06",
      "name": "Chorus",
      "hint": "Work out one output at a time.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave saw f3 a2"
        },
        "C": {
          "signal": "wave square f5 a5"
        }
      },
      "blocks": {
        "g": {
          "kind": "W3"
        },
        "h": {
          "kind": "W1"
        },
        "k": {
          "kind": "W2",
          "state": 1
        },
        "m": {
          "kind": "W4"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
