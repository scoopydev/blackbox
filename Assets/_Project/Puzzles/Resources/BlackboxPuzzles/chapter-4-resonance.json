{
  "id": "resonance",
  "numeral": "IV",
  "title": "Resonance",
  "mode": "wiring",
  "medium": "wave",
  "tagline": "Listen closely.",
  "signals": "Signals here are waves: a sine, square or saw. F, from 1 to 7, is how fast a wave repeats and how high it sounds. A, from 1 to 7, is how tall it is and how loud. A wave marked p1, p2 or p3 starts a quarter, a half or three quarters of a cycle late.",
  "circuits": [
    {
      "id": "resonance-01",
      "name": "Hum",
      "hint": "These wires are drawn already. Listen to the target, run it, then move g's input to the other wave.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a5"
        },
        "B": {
          "signal": "wave saw f3 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "W1"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "B -> g",
        "g -> X"
      ],
      "solution": [
        "A -> g",
        "g -> X"
      ]
    },
    {
      "id": "resonance-02",
      "name": "Splice",
      "hint": "One of g's inputs is empty.",
      "inputs": {
        "A": {
          "signal": "wave sine f3 a2"
        },
        "B": {
          "signal": "wave square f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "W3"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "resonance-03",
      "name": "Timbre",
      "hint": "Wave blocks only work on a plain wave, straight from an input or another wave block.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a6"
        },
        "B": {
          "signal": "wave saw f1 a3"
        }
      },
      "blocks": {
        "g": {
          "kind": "W2"
        },
        "h": {
          "kind": "W4",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h",
        "h -> X"
      ]
    },
    {
      "id": "resonance-04",
      "name": "Offset",
      "hint": "Which wave goes on top matters.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        },
        "B": {
          "signal": "wave saw f1 a4"
        }
      },
      "blocks": {
        "g": {
          "kind": "W4"
        },
        "h": {
          "kind": "W3",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "B -> h.0",
        "g -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "resonance-05",
      "name": "Echo",
      "hint": "Two outputs. Listen to each target on its own.",
      "inputs": {
        "A": {
          "signal": "wave square f2 a3"
        },
        "B": {
          "signal": "wave sine f4 a6"
        }
      },
      "blocks": {
        "g": {
          "kind": "W1",
          "state": 1
        },
        "h": {
          "kind": "W2",
          "state": 2
        },
        "k": {
          "kind": "W4",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
