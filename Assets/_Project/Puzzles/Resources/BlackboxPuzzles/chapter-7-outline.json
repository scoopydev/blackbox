{
  "id": "outline",
  "title": "Outline",
  "mode": "wiring",
  "tagline": "Solid has to be used. Dotted may not be.",
  "signals": "Every kind of signal, as before. What's new is the outlines. Every input, and every block with a solid outline, has to lead to an output, but a block with a dotted outline may be left out, or used. A dotted outline never says which.",
  "circuits": [
    {
      "id": "outline-01",
      "hint": "A dotted block may be left out, or used: its outline doesn't say which. Everything solid has to lead to an output.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "binary 0110"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER",
          "optional": true
        },
        "h": {
          "kind": "MIX"
        },
        "k": {
          "kind": "FLIP",
          "optional": true
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h.0",
        "B -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "outline-02",
      "hint": "B has to be used, but wired in as it is, it doesn't fit. A dotted block can change it on the way.",
      "inputs": {
        "A": {
          "signal": "decimal 2709"
        },
        "B": {
          "signal": "decimal 0369"
        }
      },
      "blocks": {
        "g": {
          "kind": "MAX"
        },
        "h": {
          "kind": "MIRROR",
          "optional": true
        },
        "k": {
          "kind": "NOT",
          "optional": true
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "B -> h",
        "A -> g.0",
        "h -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "outline-03",
      "hint": "A dotted block isn't a clue. Work out the target from what has to be used first.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        },
        "B": {
          "signal": "decimal 3"
        },
        "C": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIN"
        },
        "h": {
          "kind": "DIFF"
        },
        "k": {
          "kind": "LATER",
          "optional": true
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h.0",
        "C -> h.1",
        "h -> X"
      ]
    },
    {
      "id": "outline-04",
      "hint": "Dotted doesn't mean spare. Sometimes every dotted block is needed, one after the other, and then the order matters.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave saw f1 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIX"
        },
        "h": {
          "kind": "MAX"
        },
        "k": {
          "kind": "LATER",
          "optional": true
        },
        "m": {
          "kind": "FASTER",
          "optional": true
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> k",
        "k -> m",
        "m -> g.0",
        "B -> g.1",
        "g -> X",
        "A -> h.0",
        "B -> h.1",
        "h -> Y"
      ]
    },
    {
      "id": "outline-05",
      "hint": "Two dotted blocks. Work out what each output needs, and leave out what nothing needs.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "binary 0110"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIX"
        },
        "h": {
          "kind": "AND"
        },
        "k": {
          "kind": "NOT",
          "optional": true
        },
        "m": {
          "kind": "FASTER",
          "optional": true
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> m",
        "m -> g.0",
        "A -> g.1",
        "g -> X",
        "B -> h.0",
        "g -> h.1",
        "h -> Y"
      ]
    }
  ]
}
