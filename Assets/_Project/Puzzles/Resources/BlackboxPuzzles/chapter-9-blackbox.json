        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "decimal 2"
        },
        "C": {
          "signal": "decimal 5"
        },
        "D": {
          "signal": "binary 0110"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIDDLE",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "MIRROR",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "FLIP",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
