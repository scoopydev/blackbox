{
  "id": "blackbox",
  "title": "Blackbox",
  "mode": "wiring",
  "tagline": "Everything at once.",
  "signals": "Bigger circuits with every kind of signal and block. Late in the chapter come blocks with three inputs: learn them the same way, by wiring them up and pressing RUN.",
  "guide": "recap",
  "circuits": [
    {
      "id": "blackbox-01",
      "hint": "A metronome: it ticks, and Y counts the ticks through the loop.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "decimal 6"
        },
        "C": {
          "signal": "binary 1"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER"
        },
        "h": {
          "kind": "FASTER"
        },
        "k": {
          "kind": "COMPARE"
        },
        "m": {
          "kind": "COUNT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h",
        "h -> k.0",
        "B -> k.1",
        "k -> X",
        "k -> m",
        "m -> Y"
      ]
    },
    {
      "id": "blackbox-02",
      "hint": "A short burst of sound, then its echo a moment later. Listen to it.",
      "inputs": {
        "A": {
          "signal": "wave sine f6 a7"
        },
        "B": {
          "signal": "binary 1000"
        },
        "C": {
          "signal": "binary 0110"
        },
        "D": {
          "signal": "decimal 5"
        }
      },
      "blocks": {
        "g": {
          "kind": "GATE",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "LATER",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "MIX",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> h",
        "g -> k.0",
        "h -> k.1",
        "k -> X"
      ]
    },
    {
      "id": "blackbox-03",
      "hint": "Two pulses cut from a saw, the same pulses upside down, and a count of them. The pulses light while the saw is above a line, but no input is that line.",
      "inputs": {
        "A": {
          "signal": "wave saw f2 a7"
        },
        "B": {
          "signal": "decimal 6"
        },
        "C": {
          "signal": "decimal 2"
        }
      },
      "blocks": {
        "g": {
          "kind": "COMPARE"
        },
        "h": {
          "kind": "DIFF"
        },
        "k": {
          "kind": "COUNT"
        },
        "m": {
          "kind": "NOT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "h -> g.1",
        "B -> h.0",
        "C -> h.1",
        "g -> X",
        "g -> m",
        "m -> Y",
        "g -> k",
        "k -> Z"
      ]
    },
    {
      "id": "blackbox-04",
      "hint": "A slow tide with quick ripples on it. Y is on while the tide is high.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave sine f1 a3"
        },
        "C": {
          "signal": "decimal 6"
        },
        "D": {
          "signal": "binary 0101"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER",
          "at": [
            1,
            0.5
          ]
        },
        "h": {
          "kind": "FASTER",
          "at": [
            1,
            2.5
          ]
        },
        "k": {
          "kind": "MIX",
          "at": [
            2,
            0.5
          ]
        },
        "m": {
          "kind": "COMPARE",
          "at": [
            2,
            2.5
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "B -> g",
        "g -> h",
        "A -> k.0",
        "h -> k.1",
        "k -> X",
        "k -> m.0",
        "C -> m.1",
        "m -> Y"
      ]
    },
    {
      "id": "blackbox-05",
      "hint": "One saw read three ways: a staircase from 9 down to 0, one blip, and two blips. Two blocks read it as a bit and one as a digit.",
      "inputs": {
        "A": {
          "signal": "wave saw f1 a7"
        },
        "B": {
          "signal": "binary 0110"
        },
        "C": {
          "signal": "decimal 9"
        }
      },
      "blocks": {
        "g": {
          "kind": "NOT"
        },
        "h": {
          "kind": "XOR"
        },
        "k": {
          "kind": "DIFF"
        },
        "m": {
          "kind": "AND"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> m.0",
        "B -> m.1",
        "m -> X",
        "A -> h.0",
        "B -> h.1",
        "h -> Z",
        "C -> k.0",
        "A -> k.1",
        "k -> Y"
      ]
    },
    {
      "id": "blackbox-06",
      "hint": "{g} is a new kind of block, with three inputs: a vote. Wire all three, then watch what it sends at each step.",
      "inputs": {
        "A": {
          "signal": "binary 0011"
        },
        "B": {
          "signal": "binary 0101"
        },
        "C": {
          "signal": "wave sine f1 a7"
        },
        "D": {
          "signal": "decimal 6"
        }
      },
      "blocks": {
        "g": {
          "kind": "MAJORITY",
          "at": [
            1,
            0
          ]
        },
        "h": {
          "kind": "NOT",
          "at": [
            1,
            1.5
          ]
        },
        "k": {
          "kind": "COMPARE",
          "at": [
            1,
            3
          ]
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "C -> k.0",
        "D -> k.1",
        "A -> g.0",
        "B -> g.1",
        "k -> g.2",
        "g -> X",
        "g -> h",
        "h -> Y"
      ]
    },
    {
      "id": "blackbox-07",
      "hint": "{g} is a new kind of block, with three inputs. Remember slicing a wave flat in Unmarked? Where does the target stop rising, and where does it start?",
