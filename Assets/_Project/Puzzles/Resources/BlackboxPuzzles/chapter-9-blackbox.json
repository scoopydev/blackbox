    {
      "id": "blackbox-09",
      "hint": "{g} is a new kind of block, with three inputs. One of them decides what it sends. Listen: the target wails up and down like a siren.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        },
        "B": {
          "signal": "binary 1001"
        },
        "C": {
          "signal": "wave saw f1 a7"
