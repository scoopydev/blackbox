{
  "id": "resonance",
  "numeral": "III",
  "title": "Resonance",
  "mode": "wiring",
  "medium": "wave",
  "tagline": "Listen closely.",
  "signals": "Signals here are waves: a sine, square or saw. F, from 1 to 7, is how fast a wave repeats and how high it sounds. A, from 1 to 7, is how tall it is and how loud. A wave marked p1, p2 or p3 starts a quarter, a half or three quarters of a cycle late.",
  "circuits": [
    {
      "id": "resonance-01",
      "name": "Hum",
      "hint": "These wires are drawn already. Listen to the target, run it, then move {g}'s input to the other wave.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a5"
        },
        "B": {
          "signal": "wave saw f3 a7"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "B -> g",
        "g -> X"
      ],
      "solution": [
        "A -> g",
        "g -> X"
      ]
    },
    {
      "id": "resonance-02",
      "name": "Splice",
      "hint": "One of {g}'s inputs is empty.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a6"
        },
        "B": {
          "signal": "wave square f3 a2"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "resonance-03",
      "name": "Timbre",
      "hint": "The order the blocks come in matters.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a6"
        },
        "B": {
          "signal": "wave saw f1 a3"
        }
      },
      "blocks": {
        "g": {
          "kind": "FASTER"
        },
        "h": {
          "kind": "LATER"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "B -> h",
        "h -> g",
        "g -> X"
      ]
    },
    {
      "id": "resonance-04",
      "name": "Offset",
      "hint": "One block's signal can feed an output and another block at once.",
      "inputs": {
        "A": {
          "signal": "wave sine f2 a7"
        },
        "B": {
          "signal": "wave saw f1 a4"
        }
      },
      "blocks": {
        "g": {
          "kind": "FLIP"
        },
        "h": {
          "kind": "MIX"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "B -> g",
        "g -> X",
        "A -> h.0",
        "g -> h.1",
        "h -> Y"
      ]
    },
    {
      "id": "resonance-05",
      "name": "Echo",
      "hint": "Two outputs. Listen to each target on its own.",
      "inputs": {
        "A": {
          "signal": "wave square f1 a3"
        },
        "B": {
          "signal": "wave sine f1 a6"
        }
      },
      "blocks": {
        "g": {
          "kind": "LATER"
        },
        "h": {
          "kind": "FLIP"
        },
        "k": {
          "kind": "FASTER"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> h",
        "h -> X",
        "B -> k",
        "k -> Y"
      ]
    },
    {
      "id": "resonance-06",
      "name": "Chorus",
      "hint": "Work out one output at a time.",
      "inputs": {
        "A": {
          "signal": "wave sine f1 a7"
        },
        "B": {
          "signal": "wave saw f2 a2"
        },
        "C": {
          "signal": "wave square f1 a5"
        }
      },
      "blocks": {
        "g": {
          "kind": "MIX"
        },
        "h": {
          "kind": "FASTER"
        },
        "k": {
          "kind": "FLIP"
        },
        "m": {
          "kind": "LATER"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "C -> k",
        "k -> g.0",
        "B -> g.1",
        "g -> X",
        "A -> h",
        "h -> m",
        "m -> Y"
      ]
    }
  ]
}
