          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "speaker"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X",
        "A -> h",
        "h -> k",
        "k -> Y"
      ]
    },
    {
      "id": "grain-06",
      "name": "Mosaic",
      "hint": "Work out one output at a time.",
      "inputs": {
        "A": {
          "signal": "sampled sine f1 a7 s12"
        },
        "B": {
          "signal": "sampled saw f3 a3 s6"
        },
        "C": {
          "signal": "sampled square f2 a5 s3"
        }
      },
      "blocks": {
        "g": {
          "kind": "Q4",
          "state": 1
        },
        "h": {
          "kind": "Q3"
        },
        "k": {
