{
  "id": "grain",
  "numeral": "V",
  "title": "Grain",
  "mode": "wiring",
  "medium": "sampled",
  "tagline": "Up close, every curve is a staircase.",
  "signals": "Signals here are sampled waves: a wave read a few times a cycle, rounded to a whole level and held, so it moves in steps. F and A work as for waves; S, 3, 6 or 12, is how many steps make one cycle. They sound buzzy, the more so the fewer the steps.",
  "circuits": [
    {
      "id": "grain-01",
      "name": "Stairs",
      "hint": "These wires are drawn already. Run it, then move {g}'s input to the other wave.",
      "inputs": {
        "A": {
          "signal": "sampled sine f1 a7 s3"
        },
        "B": {
          "signal": "sampled saw f2 a5 s6"
        }
      },
      "blocks": {
        "g": {
          "kind": "Q1"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "B -> g",
        "g -> X"
      ],
      "solution": [
        "A -> g",
        "g -> X"
      ]
    },
    {
      "id": "grain-02",
      "name": "Graft",
      "hint": "One of {g}'s inputs is empty.",
      "inputs": {
        "A": {
          "signal": "sampled sine f2 a7 s12"
        },
        "B": {
          "signal": "sampled square f1 a3 s3"
        }
      },
      "blocks": {
        "g": {
          "kind": "Q3"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "grain-03",
      "name": "Level",
      "hint": "A servo follows the steps.",
      "inputs": {
        "A": {
          "signal": "sampled saw f1 a5 s6"
        },
        "B": {
          "signal": "sampled sine f2 a2 s12"
        }
      },
      "blocks": {
        "g": {
          "kind": "Q2"
        },
        "h": {
          "kind": "Q1",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "servo"
        }
      },
      "solution": [
        "A -> g",
        "g -> h",
        "h -> X"
      ]
    },
    {
      "id": "grain-04",
      "name": "Measure",
      "hint": "Listen: louder is taller.",
      "inputs": {
        "A": {
          "signal": "sampled sine f3 a3 s6"
        },
        "B": {
          "signal": "sampled square f1 a6 s3"
        },
        "C": {
          "signal": "sampled saw f2 a4 s12"
        }
      },
      "blocks": {
        "g": {
          "kind": "Q4"
        },
        "h": {
          "kind": "Q2",
          "state": 1
        }
      },
      "outputs": {
        "X": {
          "device": "speaker"
        }
      },
      "solution": [
        "A -> g.0",
        "C -> g.1",
        "g -> h",
        "h -> X"
      ]
    },
    {
      "id": "grain-05",
      "name": "Replay",
      "hint": "One input can feed many wires.",
      "inputs": {
        "A": {
          "signal": "sampled sine f2 a6 s12"
        },
        "B": {
          "signal": "sampled saw f1 a3 s3"
        }
      },
      "blocks": {
        "g": {
          "kind": "Q3",
          "state": 1
        },
        "h": {
          "kind": "Q1"
        },
        "k": {
