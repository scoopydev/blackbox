{
  "id": "forms",
  "numeral": "III",
  "title": "Forms",
  "mode": "wiring",
  "medium": "shape",
  "tagline": "Every shape is a message.",
  "signals": "Signals here are shapes: a circle, triangle, square or hexagon, hollow or solid, in cyan, pink, amber or green. You hear a click for each corner, low when solid and high when hollow.",
  "circuits": [
    {
      "id": "forms-01",
      "hint": "These wires are drawn already. Run it, then move {g}'s input to the other shape.",
      "inputs": {
        "A": {
          "signal": "shape solid pink triangle",
          "optional": true
        },
        "B": {
          "signal": "shape hollow amber square"
        }
      },
      "blocks": {
        "g": {
          "kind": "FILL"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g",
        "g -> X"
      ],
      "solution": [
        "B -> g",
        "g -> X"
      ]
    },
    {
      "id": "forms-02",
      "hint": "One of {g}'s inputs is empty.",
      "inputs": {
        "A": {
          "signal": "shape hollow green circle"
        },
        "B": {
          "signal": "shape solid hexagon"
        }
      },
      "blocks": {
        "g": {
          "kind": "TAKEFILL"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "start": [
        "A -> g.0",
        "g -> X"
      ],
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "forms-03",
      "hint": "A signal can change as the loop plays: A is a triangle, then a hexagon.",
      "inputs": {
        "A": {
          "signal": "shape solid pink triangle, solid pink hexagon"
        },
        "B": {
          "signal": "shape hollow green square"
        }
      },
      "blocks": {
        "g": {
          "kind": "TAKECOLOUR"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X"
      ]
    },
    {
      "id": "forms-04",
      "hint": "Watch how the shape changes.",
      "inputs": {
        "A": {
          "signal": "shape solid triangle"
        },
        "B": {
          "signal": "shape hollow pink hexagon",
          "optional": true
        }
      },
      "blocks": {
        "g": {
          "kind": "NEXT"
        },
        "h": {
          "kind": "FILL"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g",
        "g -> X",
        "A -> h",
        "h -> Y"
      ]
    },
    {
      "id": "forms-05",
      "hint": "Watch the colour: it stays with the shape.",
      "inputs": {
        "A": {
          "signal": "shape solid amber hexagon"
        },
        "B": {
          "signal": "shape solid green triangle"
        },
        "C": {
          "signal": "shape solid pink triangle"
        }
      },
      "blocks": {
        "g": {
          "kind": "TAKEFILL"
        },
        "h": {
          "kind": "FILL"
        },
        "k": {
          "kind": "NEXT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        }
      },
      "solution": [
        "A -> h",
        "B -> g.0",
        "h -> g.1",
        "g -> X",
        "C -> k",
        "k -> Y"
      ]
    },
    {
      "id": "forms-06",
      "hint": "Work out one output at a time.",
      "inputs": {
        "A": {
          "signal": "shape solid amber triangle, hollow green hexagon"
        },
        "B": {
          "signal": "shape hollow pink square"
        },
        "C": {
          "signal": "shape hollow circle"
        }
      },
      "blocks": {
        "g": {
          "kind": "TAKECOLOUR"
        },
        "h": {
          "kind": "FILL"
        },
        "k": {
          "kind": "TAKEFILL"
        },
        "m": {
          "kind": "NEXT"
        }
      },
      "outputs": {
        "X": {
          "device": "display"
        },
        "Y": {
          "device": "display"
        },
        "Z": {
          "device": "display"
        }
      },
      "solution": [
        "A -> g.0",
        "B -> g.1",
        "g -> X",
        "B -> h",
        "C -> k.0",
        "h -> k.1",
        "k -> Y",
        "A -> m",
        "m -> Z"
      ]
    }
  ]
}
